          <path class="ln" pathLength="1" d="M265 110V490M253 110H277M253 490H277" stroke-width="1.5" stroke="#cca067" style="--g:1;--d:9" />
          <text class="tx" x="253" y="308" text-anchor="middle" font-size="20" fill="#cca067" transform="rotate(-90 253 308)" style="--g:1;--d:10">3,80</text>
          <text class="tx" x="620" y="250" text-anchor="middle" font-size="15" fill="#cca067" style="--g:1;--d:9">DUCHA 1,60</text>
          <text class="tx" x="540" y="508" text-anchor="middle" font-size="15" fill="#cca067" style="--g:1;--d:10">0,80</text>
          <text class="tx" x="200" y="568" text-anchor="start" font-size="16" fill="#cca067" style="--g:1;--d:3">BAÑO · ESC. 1:25</text>
          <text class="tx" x="800" y="568" text-anchor="end" font-size="16" fill="#cca067" style="--g:1;--d:3">A-02</text>
          <path class="ln late" pathLength="1" d="M532 102A16.1 16.1 0 0 1 557.1 102A16.1 16.1 0 0 1 582.3 102A16.1 16.1 0 0 1 607.4 102A16.1 16.1 0 0 1 632.6 102A16.1 16.1 0 0 1 657.7 102A16.1 16.1 0 0 1 682.9 102A16.1 16.1 0 0 1 708.0 102A16.1 16.1 0 0 1 708.0 128.0A16.1 16.1 0 0 1 708.0 154.0A16.1 16.1 0 0 1 708.0 180.0A16.1 16.1 0 0 1 708.0 206.0A16.1 16.1 0 0 1 708.0 232.0A16.1 16.1 0 0 1 708.0 258.0A16.1 16.1 0 0 1 708.0 284.0A16.1 16.1 0 0 1 682.9 284.0A16.1 16.1 0 0 1 657.7 284.0A16.1 16.1 0 0 1 632.6 284.0A16.1 16.1 0 0 1 607.4 284.0A16.1 16.1 0 0 1 582.3 284.0A16.1 16.1 0 0 1 557.1 284.0A16.1 16.1 0 0 1 532.0 284.0A16.1 16.1 0 0 1 532.0 258.0A16.1 16.1 0 0 1 532.0 232.0A16.1 16.1 0 0 1 532.0 206.0A16.1 16.1 0 0 1 532.0 180.0A16.1 16.1 0 0 1 532.0 154.0A16.1 16.1 0 0 1 532.0 128.0A16.1 16.1 0 0 1 532.0 102.0" stroke-width="1.5" stroke="#cca067" style="--g:1;--d:0" />
          <text class="tx late-tx" x="620" y="312" text-anchor="middle" font-size="15" fill="#cca067" style="--g:1;--d:0">REV. B</text>
          <g class="cur cur-1"><circle r="9" /><path d="M-17 0H-6M6 0H17M0 -17V-6M0 6V17" /></g>
      </g>
      <g class="plan-g" stroke="#eceadb" stroke-linejoin="miter">
          <path class="gd" d="M140 100H860M140 480H860M200 60V520M800 60V520" stroke="#cca067" stroke-opacity="0.35" stroke-width="0.8" stroke-dasharray="16 5 3 5" style="--g:2;--d:0" />
          <path class="ln" pathLength="1" d="M200 100H800V480H200Z" stroke-width="4" style="--g:2;--d:0" />
          <path class="ln" pathLength="1" d="M320 100V480M440 100V480M560 100V480M680 100V480M200 200H800M200 450H800" stroke-width="2" style="--g:2;--d:2" />
          <path class="ln" pathLength="1" d="M440 300H560M440 380H560M485 250H515M485 340H515M485 425H515" stroke-width="1.5" style="--g:2;--d:4" />
          <path class="ln" pathLength="1" d="M306 300V380M694 300V380M334 140V170M666 140V170" stroke-width="1.5" style="--g:2;--d:5" />
          <path class="gd" d="M205 250H315M325 250H435M565 250H675M685 250H795M205 300H315M205 350H315M685 300H795M685 350H795M685 400H795" stroke="#eceadb" stroke-opacity="0.45" stroke-width="1" stroke-dasharray="10 6" style="--g:2;--d:6" />
          <path class="gd" d="M200 200L320 340L200 480M440 200L320 340L440 480M560 200L680 340L560 480M800 200L680 340L800 480" stroke="#eceadb" stroke-opacity="0.3" stroke-width="1" stroke-dasharray="10 6" style="--g:2;--d:7" />
          <path class="ln" pathLength="1" d="M200 78H800M200 68V88M320 68V88M440 68V88M560 68V88M680 68V88M800 68V88" stroke-width="1.5" stroke="#cca067" style="--g:2;--d:8" />
          <text class="tx" x="260" y="60" text-anchor="middle" font-size="15" fill="#cca067" style="--g:2;--d:9">0,60</text>
          <text class="tx" x="380" y="60" text-anchor="middle" font-size="15" fill="#cca067" style="--g:2;--d:9">0,60</text>
          <text class="tx" x="500" y="60" text-anchor="middle" font-size="15" fill="#cca067" style="--g:2;--d:9">0,60</text>
          <text class="tx" x="620" y="60" text-anchor="middle" font-size="15" fill="#cca067" style="--g:2;--d:9">0,60</text>
          <text class="tx" x="740" y="60" text-anchor="middle" font-size="15" fill="#cca067" style="--g:2;--d:9">0,60</text>
          <path class="ln" pathLength="1" d="M200 525H800M200 513V537M800 513V537" stroke-width="1.5" stroke="#cca067" style="--g:2;--d:8" />
          <text class="tx" x="500" y="517" text-anchor="middle" font-size="20" fill="#cca067" style="--g:2;--d:9">3,00</text>
          <path class="ln" pathLength="1" d="M835 100V480M823 100H847M823 480H847" stroke-width="1.5" stroke="#cca067" style="--g:2;--d:9" />
          <text class="tx" x="862" y="298" text-anchor="middle" font-size="20" fill="#cca067" transform="rotate(-90 862 298)" style="--g:2;--d:10">1,90</text>
          <text class="tx" x="500" y="170" text-anchor="middle" font-size="15" fill="#cca067" style="--g:2;--d:10">BAHULERAS</text>
          <text class="tx" x="200" y="568" text-anchor="start" font-size="16" fill="#cca067" style="--g:2;--d:3">PLACARD · ESC. 1:25</text>
          <text class="tx" x="800" y="568" text-anchor="end" font-size="16" fill="#cca067" style="--g:2;--d:3">A-03</text>
          <path class="ln late" pathLength="1" d="M430 242A17.4 17.4 0 0 1 458.0 242A17.4 17.4 0 0 1 486.0 242A17.4 17.4 0 0 1 514.0 242A17.4 17.4 0 0 1 542.0 242A17.4 17.4 0 0 1 570.0 242A17.4 17.4 0 0 1 570.0 269.1A17.4 17.4 0 0 1 570.0 296.2A17.4 17.4 0 0 1 570.0 323.3A17.4 17.4 0 0 1 570.0 350.4A17.4 17.4 0 0 1 570.0 377.6A17.4 17.4 0 0 1 570.0 404.7A17.4 17.4 0 0 1 570.0 431.8A17.4 17.4 0 0 1 570.0 458.9A17.4 17.4 0 0 1 570.0 486.0A17.4 17.4 0 0 1 542.0 486.0A17.4 17.4 0 0 1 514.0 486.0A17.4 17.4 0 0 1 486.0 486.0A17.4 17.4 0 0 1 458.0 486.0A17.4 17.4 0 0 1 430.0 486.0A17.4 17.4 0 0 1 430.0 458.9A17.4 17.4 0 0 1 430.0 431.8A17.4 17.4 0 0 1 430.0 404.7A17.4 17.4 0 0 1 430.0 377.6A17.4 17.4 0 0 1 430.0 350.4A17.4 17.4 0 0 1 430.0 323.3A17.4 17.4 0 0 1 430.0 296.2A17.4 17.4 0 0 1 430.0 269.1A17.4 17.4 0 0 1 430.0 242.0" stroke-width="1.5" stroke="#cca067" style="--g:2;--d:0" />
          <text class="tx late-tx" x="500" y="232" text-anchor="middle" font-size="15" fill="#cca067" style="--g:2;--d:0">REV. A</text>
          <g class="cur cur-2"><circle r="9" /><path d="M-17 0H-6M6 0H17M0 -17V-6M0 6V17" /></g>
      </g>
    </svg>
      <div class="grid justify-items-center shrink-0 pb-2">
        <a href="#proyectos" data-goto="cocinas" class="cap col-start-1 row-start-1 inline-flex items-center min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark hover:text-dun-cream" style="--g:0">Cocinas <span aria-hidden="true">→</span></a>
        <a href="#proyectos" data-goto="banos" class="cap col-start-1 row-start-1 inline-flex items-center min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark hover:text-dun-cream" style="--g:1">Baños <span aria-hidden="true">→</span></a>
        <a href="#proyectos" data-goto="mobiliario" class="cap col-start-1 row-start-1 inline-flex items-center min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark hover:text-dun-cream" style="--g:2">Placards <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-dun-darker to-transparent"></div>

    <div class="absolute inset-x-0 bottom-0 max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-24 ">
      <h1 class="word">
        <svg class="logo block h-14 md:h-20 w-auto" viewBox="160 430 760 220" fill="none" role="img" aria-label="DUN">
          <g stroke="#cca067" stroke-width="1" opacity="0.35">
            <circle class="lg-c" cx="308" cy="539" r="97" />
            <circle class="lg-c" cx="540" cy="539" r="97" />
            <circle class="lg-c" cx="772" cy="539" r="97" />
          </g>
          <path class="lg-b" pathLength="1" d="M174 636H906" stroke="#cca067" stroke-width="1.5" />
          <g stroke="#eceadb" stroke-width="18">
            <path class="lg-a" pathLength="1" d="M308 451A88 88 0 1 1 292.7 625.7" style="--i:0" />
            <path class="lg-a" pathLength="1" d="M452 539A88 88 0 0 0 628 539" style="--i:1" />
            <path class="lg-a" pathLength="1" d="M684 636A88 88 0 0 1 860 636M681 578V636" style="--i:2" />
          </g>
          <g class="lg-f" fill="#a58a72">
            <circle cx="762" cy="602" r="5" /><path d="M754 636V618Q754 609 764 609Q774 609 774 618V636Z" />
            <circle cx="799" cy="591" r="6" /><path d="M788 636V612Q788 600 799 600Q811 600 811 612V636Z" />
          </g>
        </svg>
        <span class="block mt-4 text-[11px] md:text-sm font-light tracking-[0.15em] md:tracking-[0.25em] uppercase text-dun-cream">Daniela Estevez Vredjian · Arquitecta</span>
      </h1>
    </div>

    <button
      type="button"
      id="hero-pause"
      aria-pressed="false"
      aria-label="Pausar animación"
      class="absolute top-2 right-2 md:top-4 md:right-6 w-11 h-11 flex items-center justify-center text-dun-cream-dark hover:text-dun-cream transition cursor-pointer"
    >
      <svg class="pause-ico w-4 h-4 fill-current" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" /><rect x="9.5" y="2" width="3.5" height="12" /></svg>
      <svg class="play-ico w-4 h-4 fill-current hidden" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z" /></svg>
    </button>

    <div class="absolute inset-x-0 bottom-0 max-w-7xl mx-auto px-6 md:px-10 pb-5 flex justify-center">
      <a href="#proyectos" class="inline-flex items-center gap-2 min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream hover:text-white transition">
        Ver obras <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <!-- Obras -->
  {
    projects.length > 0 && (
      <section id="proyectos" class="max-w-7xl mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-16 md:pb-24 scroll-mt-16">
        <h2 class="sr-only">Obras</h2>
        <div role="group" aria-label="Filtrar obras" class="mb-8 md:mb-12 flex flex-wrap items-center gap-2">
          {filters.map((f, i) => (
            <button
              type="button"
              data-filter-btn={f.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class:list={[
                'filter-btn px-3.5 min-h-11 text-[11px] uppercase tracking-[0.12em] rounded-full border transition-colors duration-300 cursor-pointer whitespace-nowrap',
                i === 0
                  ? 'border-dun-cream bg-dun-cream text-dun-dark font-normal'
                  : 'border-dun-cream/30 text-dun-cream-dark hover:border-dun-cream/60 hover:text-dun-cream font-light',
              ]}
            >
              {f.label}
            </button>
          ))}
          <a
            href={`${base}/obras-anteriores`}
            class="px-3.5 min-h-11 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.12em] rounded-full border border-dun-cream-dark/60 text-dun-cream-dark hover:bg-dun-cream-dark hover:text-dun-dark transition-colors duration-300 whitespace-nowrap"
          >
            Gran escala y patrimonio <span aria-hidden="true">→</span>
          </a>
        </div>
        <p id="filter-status" role="status" class="sr-only"></p>

        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 md:gap-x-8 gap-y-12 md:gap-y-14">
          {projects.map((project) => (
            <div data-project-wrap>
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ===========================================
       PATRIMONIO & TRAYECTORIA — banner arquitectónico
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-32" data-reveal>
    <a
      href={`${base}/obras-anteriores`}
      class="group relative block p-8 md:p-16 border border-dun-cream/20 hover:border-dun-cream/50 bg-dun-darker/40 transition-colors duration-700 overflow-hidden"
    >
      <!-- Background historic monument photo with duotone overlay -->
      <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <Image
          src={bannerTrayectoria}
          alt=""
          class="w-full h-full object-cover grayscale opacity-15 group-hover:opacity-25 group-hover:scale-105 transition-[opacity,transform] duration-1000 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-dun-darker via-dun-darker/85 to-transparent mix-blend-multiply"></div>
      </div>

