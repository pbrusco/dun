---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projectOrder = (slug: string) => {
  const m: Record<string, number> = {
    'cocina-devoto-2026': 1,
    'depto-saavedra-2025': 2,
    'cocina-palermo-2025': 3,
    'cocina-villa-urquiza-2025': 4,
    'ph-saavedra-2025': 5,
    'depto-corrientes-2025': 6,
    'local-palermo-2021': 7,
  };
  return m[slug] ?? 99;
};
const reforms = allProjects
  .filter((p) => p.data.category !== 'Patrimonio')
  .sort((a, b) => projectOrder(a.slug) - projectOrder(b.slug));

const featured = reforms[0];
const rest = reforms.slice(1);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<Layout title="Proyectos">
  <!-- ===========================================
       HERO — editorial, asymmetric, oversized
  =========================================== -->
  <section class="relative overflow-hidden">
    <!-- top meta strip -->
    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 flex items-start justify-between text-[10px] uppercase tracking-[0.3em] text-dun-cream-dark/60 font-light anim-rise">
      <span>Estudio · Buenos Aires</span>
      <span class="hidden md:inline">Índice · {String(reforms.length).padStart(2, '0')} obras</span>
      <span>MMXXI — MMXXVI</span>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12 md:pb-24 grid grid-cols-12 gap-y-10 md:gap-y-0">

      <!-- Decorative numeral, hidden on mobile -->
      <div class="hidden md:block col-span-2 pt-4 anim-rise" style="--rise-delay: 80ms">
        <div class="dun-numeral text-[7rem] xl:text-[9rem]">N°</div>
        <div class="dun-numeral text-[7rem] xl:text-[9rem] -mt-6">01</div>
      </div>

      <header class="col-span-12 md:col-span-9 md:col-start-3">
        <h1 class="anim-rise" style="--rise-delay: 120ms">
          <span class="block text-[15vw] md:text-[10vw] xl:text-[9rem] font-thin leading-[0.95] tracking-[-0.01em] text-dun-cream">
            Diseñando
          </span>
          <span class="block text-[15vw] md:text-[10vw] xl:text-[9rem] font-thin leading-[0.95] tracking-[-0.01em] text-dun-cream pl-[8%] md:pl-[14%] italic-faux">
            espacios,
          </span>
          <span class="block text-[15vw] md:text-[10vw] xl:text-[9rem] font-extralight leading-[0.95] tracking-[-0.01em] text-dun-cream-dark mt-2 md:mt-4">
            preservando
          </span>
          <span class="block text-[15vw] md:text-[10vw] xl:text-[9rem] font-light leading-[0.95] tracking-[-0.01em] text-dun-cream-dark pl-[20%] md:pl-[28%]">
            historias.
          </span>
        </h1>

        <div class="mt-12 md:mt-20 grid md:grid-cols-12 gap-8 items-end anim-rise" style="--rise-delay: 480ms">
          <p class="md:col-span-7 md:col-start-1 text-base md:text-lg text-dun-cream-dark/90 leading-relaxed font-light tracking-wide max-w-2xl">
            Arquitecta especializada en la reforma de viviendas y la restauración de
            patrimonio histórico en Buenos Aires. Proyecto, coordino y dirijo cada obra de
            principio a fin.
          </p>
          <p class="md:col-span-4 md:col-start-9 text-[11px] uppercase tracking-[0.3em] text-dun-muted leading-relaxed font-light md:text-right">
            <span class="italic-faux normal-case tracking-wider text-sm text-dun-cream-dark">
              encontramos la forma de hacer <span class="text-dun-cream font-normal">hogar</span>
            </span>
          </p>
        </div>
      </header>
    </div>

    <!-- Hairline rule -->
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="dun-rule"></div>
    </div>
  </section>

  <!-- ===========================================
       FEATURED PROJECT — large hero card
  =========================================== -->
  {
    featured && (
      <section class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24" data-reveal>
        <div class="flex items-baseline justify-between mb-8 md:mb-12">
          <div>
            <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted mb-2">Obra reciente</p>
            <h2 class="text-2xl md:text-3xl font-extralight tracking-wide text-dun-cream">En proceso · {currentYear}</h2>
          </div>
          <span class="dun-numeral text-5xl md:text-7xl">01</span>
        </div>
        <ProjectCard project={featured} variant="featured" index={1} />
      </section>
    )
  }

  <!-- ===========================================
       PROJECT INDEX
  =========================================== -->
  {
    rest.length > 0 && (
      <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-24" data-reveal>
        <div class="flex items-baseline justify-between mb-8 md:mb-12">
          <div>
            <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted mb-2">Índice de proyectos</p>
            <h2 class="text-2xl md:text-3xl font-extralight tracking-wide text-dun-cream">
              Reformas & Interiorismo
            </h2>
          </div>
          <span class="dun-numeral text-5xl md:text-7xl">{String(rest.length).padStart(2, '0')}</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14">
          {rest.map((project, i) => (
            <ProjectCard project={project} index={i + 2} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ===========================================
       OBRAS ANTERIORES CTA — editorial banner
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-16 md:pb-24" data-reveal>
    <a
      href={`${base}/obras-anteriores`}
      class="group relative block py-12 md:py-20 border-t border-b border-dun-cream/15 hover:border-dun-cream-dark/40 transition-colors duration-700 overflow-hidden"
    >
      <!-- background numeral — Lexend renders Roman numerals cleanly at giant scale -->
      <span
        aria-hidden="true"
        class="absolute right-4 -top-2 md:top-1/2 md:-translate-y-1/2 dun-numeral text-[10rem] md:text-[16rem] pointer-events-none select-none opacity-[0.07] group-hover:opacity-[0.13] transition-opacity duration-700"
      >
        II
      </span>

      <div class="relative grid md:grid-cols-12 gap-6 items-center">
        <div class="md:col-span-2">
          <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted">Trayectoria</p>
        </div>
        <div class="md:col-span-7">
          <h2 class="text-4xl md:text-6xl font-thin tracking-tight text-dun-cream leading-[0.95]">
            Obras anteriores
          </h2>
          <p class="mt-4 md:mt-6 text-base md:text-lg text-dun-cream-dark/85 font-light max-w-2xl leading-relaxed">
            Restauración de patrimonio, aeropuertos y obras de gran escala realizadas junto
            a constructoras y estudios.
          </p>
        </div>
        <div class="md:col-span-3 md:text-right">
          <span class="inline-flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark group-hover:text-dun-cream transition">
            Ver galería
            <span class="block w-8 h-px bg-current group-hover:w-14 transition-all duration-500"></span>
          </span>
        </div>
      </div>
    </a>
  </section>

  <!-- Empty state -->
  {
    allProjects.length === 0 && (
      <section class="max-w-7xl mx-auto px-6 py-20 text-center text-dun-muted">
        <p class="text-lg font-light">Los proyectos aparecerán acá una vez que los agregues en <code>src/content/projects/</code>.</p>
      </section>
    )
  }
</Layout>

<style>
  /* Lexend has no native italic — use a refined synthesized slant only where we want a typographic accent */
  .italic-faux {
    font-style: italic;
  }
</style>
