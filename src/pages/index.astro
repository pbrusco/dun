          <text class="tx" x="460" y="336" text-anchor="middle" font-size="15" fill="#cca067" style="--g:0;--d:9">ISLA 2,00 × 0,80</text>
          <text class="tx" x="300" y="503" text-anchor="middle" font-size="15" fill="#cca067" style="--g:0;--d:10">0,80</text>
          <text class="tx" x="200" y="568" text-anchor="start" font-size="16" fill="#cca067" style="--g:0;--d:3">COCINA · ESC. 1:25</text>
          <text class="tx" x="800" y="568" text-anchor="end" font-size="16" fill="#cca067" style="--g:0;--d:3">A-01</text>
          <path class="ln late" pathLength="1" d="M318 98A19.8 19.8 0 0 1 345.7 98A19.8 19.8 0 0 1 373.3 98A19.8 19.8 0 0 1 401.0 98A19.8 19.8 0 0 1 428.7 98A19.8 19.8 0 0 1 456.3 98A19.8 19.8 0 0 1 484.0 98A19.8 19.8 0 0 1 484.0 130.0A19.8 19.8 0 0 1 484.0 162.0A19.8 19.8 0 0 1 456.3 162.0A19.8 19.8 0 0 1 428.7 162.0A19.8 19.8 0 0 1 401.0 162.0A19.8 19.8 0 0 1 373.3 162.0A19.8 19.8 0 0 1 345.7 162.0A19.8 19.8 0 0 1 318.0 162.0A19.8 19.8 0 0 1 318.0 130.0A19.8 19.8 0 0 1 318.0 98.0" stroke-width="1.5" stroke="#cca067" style="--g:0;--d:0" />
          <text class="tx late-tx" x="401" y="190" text-anchor="middle" font-size="15" fill="#cca067" style="--g:0;--d:0">REV. A</text>
          <g class="cur cur-0"><circle r="9" /><path d="M-17 0H-6M6 0H17M0 -17V-6M0 6V17" /></g>
      </g>
      <g class="plan-g" stroke="#eceadb" stroke-linejoin="miter">
          <path class="gd" d="M240 110H760M240 490H760M300 70V530M700 70V530M540 110V490" stroke="#cca067" stroke-opacity="0.35" stroke-width="0.8" stroke-dasharray="16 5 3 5" style="--g:1;--d:0" />
          <path class="ln" pathLength="1" d="M500 490H300V110H700V490H580" stroke-width="4" style="--g:1;--d:0" />
          <path class="ln" pathLength="1" d="M508 482H308V118H692V482H580" stroke-width="1" style="--g:1;--d:1" />
