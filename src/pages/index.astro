---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bannerTrayectoria from '../assets/images/obras-anteriores/manzana-luces/01.jpg';

const allProjects = await getCollection('projects');
const projectOrder = (slug: string) => {
  const m: Record<string, number> = {
    'cocina-devoto-2026': 1,
    'villa-ortuzar-2026': 2,
    'bano-caballito-2026': 3,
    'bano-barracas-2026': 4,
    'depto-saavedra-2025': 5,
    'cocina-palermo-2025': 6,
    'cocina-villa-urquiza-2025': 7,
    'ph-saavedra-2025': 8,
    'depto-corrientes-2025': 9,
    'bano-ph-saavedra-2025': 10,
    'bano-palermo-2025': 11,
    'bano-olivos-2025': 12,
    'placard-villa-urquiza-2025': 13,
    'placard-villa-pueyrredon-2025': 14,
    'local-palermo-2021': 15,
  };
  return m[slug] ?? 99;
};
const projects = allProjects.sort((a, b) => projectOrder(a.slug) - projectOrder(b.slug));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const filters = [
  { key: 'todos', label: 'Todos' },
  { key: 'cocinas', label: 'Cocinas' },
  { key: 'banos', label: 'Baños' },
  { key: 'reformas', label: 'Reformas' },
  { key: 'mobiliario', label: 'Mobiliario' },
  { key: 'comercial', label: 'Comercial' },
];
---

<Layout
  title="DUN · Estudio de arquitectura"
  description="DUN · Estudio de arquitectura en Buenos Aires. Obras y proyectos de Daniela Estevez Vredjian."
>
  <!-- Portada: planos que se dibujan solos (cocina, baño, placard) -->
  <section id="portada" class="relative w-full overflow-hidden bg-dun-darker h-[calc(100svh-4rem)] min-h-[480px]" aria-label="Portada">
    <div class="absolute inset-x-0 top-4 md:top-6 h-[calc(100%-14rem)] md:h-[calc(100%-17rem)] flex flex-col items-center px-6 md:px-10">
    <svg
      class="plan w-full max-w-3xl flex-1 min-h-0"
      viewBox="170 70 660 490"
      preserveAspectRatio="xMidYMid meet"
      fill="none"
      stroke-linecap="square"
      aria-hidden="true"
    >
      <g class="plan-g" stroke="#eceadb" stroke-linejoin="miter">
          <path class="ln" pathLength="1" d="M340 480H800V100H200V480H260" stroke-width="4" style="--g:0;--d:0" opacity="1" />
          <path class="ln" pathLength="1" d="M260 480V400A80 80 0 0 1 340 480" stroke-width="1.5" style="--g:0;--d:2" opacity="0.85" />
          <path class="ln" pathLength="1" d="M200 160H740V420H800" stroke-width="1.5" style="--g:0;--d:3" opacity="1" />
          <path class="ln" pathLength="1" d="M330 112H400V148H330ZM410 112H470V148H410Z" stroke-width="1.5" style="--g:0;--d:4" opacity="1" />
          <path class="ln" pathLength="1" d="M560 108H680V152H560ZM576 122a9 9 0 1 0 18 0a9 9 0 1 0 -18 0M646 122a9 9 0 1 0 18 0a9 9 0 1 0 -18 0M576 140a9 9 0 1 0 18 0a9 9 0 1 0 -18 0M646 140a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" stroke-width="1.5" style="--g:0;--d:5" opacity="1" />
          <path class="ln" pathLength="1" d="M748 190H792V270H748ZM748 190L792 270M792 190L748 270" stroke-width="1.5" style="--g:0;--d:6" opacity="1" />
          <path class="ln" pathLength="1" d="M360 290H560V370H360ZM376 402a14 14 0 1 0 28 0a14 14 0 1 0 -28 0M446 402a14 14 0 1 0 28 0a14 14 0 1 0 -28 0M516 402a14 14 0 1 0 28 0a14 14 0 1 0 -28 0" stroke-width="1.5" style="--g:0;--d:7" opacity="1" />
          <path class="ln" pathLength="1" d="M200 525H800M200 513V537M800 513V537" stroke-width="1.5" style="--g:0;--d:9" opacity="1" />
      </g>
      <g class="plan-g" stroke="#eceadb" stroke-linejoin="miter">
          <path class="ln" pathLength="1" d="M360 490H300V110H700V490H440" stroke-width="4" style="--g:1;--d:0" opacity="1" />
          <path class="ln" pathLength="1" d="M440 490V410A80 80 0 0 0 360 490" stroke-width="1.5" style="--g:1;--d:2" opacity="0.85" />
          <path class="ln" pathLength="1" d="M540 110V270H700M612 190a8 8 0 1 0 16 0a8 8 0 1 0 -16 0M670 132a12 12 0 1 0 24 0a12 12 0 1 0 -24 0" stroke-width="1.5" style="--g:1;--d:3" opacity="1" />
          <path class="ln" pathLength="1" d="M340 110V170H470V110M383 140a22 22 0 1 0 44 0a22 22 0 1 0 -44 0" stroke-width="1.5" style="--g:1;--d:4" opacity="1" />
          <path class="ln" pathLength="1" d="M300 335H340V395H300ZM340 335H390C420 335 420 395 390 395H340Z" stroke-width="1.5" style="--g:1;--d:5" opacity="1" />
          <path class="ln" pathLength="1" d="M300 535H700M300 523V547M700 523V547" stroke-width="1.5" style="--g:1;--d:8" opacity="1" />
      </g>
      <g class="plan-g" stroke="#eceadb" stroke-linejoin="miter">
          <path class="ln" pathLength="1" d="M200 100H800V480H200Z" stroke-width="4" style="--g:2;--d:0" opacity="1" />
          <path class="ln" pathLength="1" d="M320 100V480M440 100V480M560 100V480M680 100V480M200 200H800" stroke-width="2" style="--g:2;--d:2" opacity="1" />
          <path class="ln" pathLength="1" d="M440 300H560M440 380H560M485 250H515M485 340H515M485 430H515" stroke-width="1.5" style="--g:2;--d:4" opacity="1" />
          <path class="ln" pathLength="1" d="M306 300V380M694 300V380M334 140V170M666 140V170" stroke-width="1.5" style="--g:2;--d:5" opacity="1" />
          <path class="ln" pathLength="1" d="M200 525H800M200 513V537M800 513V537M850 100V480M838 100H862M838 480H862" stroke-width="1.5" style="--g:2;--d:7" opacity="1" />
      </g>
    </svg>
      <div class="grid justify-items-center shrink-0 pb-2">
        <a href="#proyectos" data-goto="cocinas" class="cap col-start-1 row-start-1 inline-flex items-center min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark hover:text-dun-cream" style="--g:0">Cocinas →</a>
        <a href="#proyectos" data-goto="banos" class="cap col-start-1 row-start-1 inline-flex items-center min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark hover:text-dun-cream" style="--g:1">Baños →</a>
        <a href="#proyectos" data-goto="mobiliario" class="cap col-start-1 row-start-1 inline-flex items-center min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark hover:text-dun-cream" style="--g:2">Placards →</a>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-dun-darker to-transparent"></div>

    <div class="absolute inset-x-0 bottom-0 max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-24 ">
      <h1 class="word">
        <svg class="logo block h-14 md:h-20 w-auto" viewBox="160 430 760 220" fill="none" role="img" aria-label="DUN">
          <g stroke="#cca067" stroke-width="1" opacity="0.35">
            <circle class="lg-c" cx="308" cy="539" r="97" />
            <circle class="lg-c" cx="540" cy="539" r="97" />
            <circle class="lg-c" cx="772" cy="539" r="97" />
          </g>
          <path class="lg-b" pathLength="1" d="M174 636H906" stroke="#cca067" stroke-width="1.5" />
          <g stroke="#eceadb" stroke-width="18">
            <path class="lg-a" pathLength="1" d="M308 451A88 88 0 1 1 292.7 625.7" style="--i:0" />
            <path class="lg-a" pathLength="1" d="M452 539A88 88 0 0 0 628 539" style="--i:1" />
            <path class="lg-a" pathLength="1" d="M684 636A88 88 0 0 1 860 636M681 578V636" style="--i:2" />
          </g>
          <g class="lg-f" fill="#a58a72">
            <circle cx="762" cy="602" r="5" /><path d="M754 636V618Q754 609 764 609Q774 609 774 618V636Z" />
            <circle cx="799" cy="591" r="6" /><path d="M788 636V612Q788 600 799 600Q811 600 811 612V636Z" />
          </g>
        </svg>
        <span class="block mt-4 text-[11px] md:text-sm font-extralight tracking-[0.25em] uppercase text-dun-cream">Estudio de arquitectura · Buenos Aires</span>
      </h1>
    </div>

    <div class="absolute inset-x-0 bottom-0 max-w-7xl mx-auto px-6 md:px-10 pb-5 flex justify-center">
      <a href="#proyectos" class="inline-flex items-center gap-2 min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream hover:text-white transition">
        Ver obras <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <!-- Obras -->
  {
    projects.length > 0 && (
      <section id="proyectos" class="max-w-7xl mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-16 md:pb-24 scroll-mt-16">
        <nav aria-label="Filtro de obras" class="mb-8 md:mb-12 flex items-center gap-2 overflow-x-auto no-scrollbar -mx-6 px-6 md:mx-0 md:px-0 py-1">
          {filters.map((f, i) => (
            <button
              type="button"
              data-filter-btn={f.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class:list={[
                'filter-btn px-4 min-h-11 text-[11px] uppercase tracking-[0.2em] rounded-full border transition-all duration-300 cursor-pointer whitespace-nowrap',
                i === 0
                  ? 'border-dun-cream bg-dun-cream text-dun-dark font-normal'
                  : 'border-dun-cream/30 text-dun-cream-dark hover:border-dun-cream/60 hover:text-dun-cream font-light',
              ]}
            >
              {f.label}
            </button>
          ))}
        </nav>

        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 md:gap-x-8 gap-y-12 md:gap-y-14">
          {projects.map((project, i) => (
            <div class={i === 0 ? 'md:col-span-2 lg:col-span-3' : ''} data-project-wrap>
              <ProjectCard project={project} index={i + 1} variant={i === 0 ? 'featured' : 'default'} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ===========================================
       PATRIMONIO & TRAYECTORIA — banner arquitectónico
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-32" data-reveal>
    <a
      href={`${base}/obras-anteriores`}
      class="group relative block p-8 md:p-16 border border-dun-cream/20 hover:border-dun-cream/50 bg-dun-darker/40 transition-all duration-700 overflow-hidden"
    >
      <!-- Background historic monument photo with duotone overlay -->
      <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <Image
          src={bannerTrayectoria}
          alt="Restauración de patrimonio histórico - Manzana de las Luces"
          class="w-full h-full object-cover grayscale opacity-15 group-hover:opacity-25 group-hover:scale-105 transition-all duration-1000 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-dun-darker via-dun-darker/85 to-transparent mix-blend-multiply"></div>
      </div>

      <!-- decorative background wordmark -->
      <span
        aria-hidden="true"
        class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 font-thin tracking-[0.2em] text-[8rem] md:text-[14rem] leading-none text-dun-cream pointer-events-none select-none opacity-[0.04] group-hover:opacity-[0.08] transition-opacity duration-700"
      >
        DUN
      </span>

      <div class="relative z-10 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-dun-cream-dark mb-4">
            <span class="w-6 h-px bg-dun-cream-dark/40"></span>
            <span>Trayectoria</span>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-6xl font-thin tracking-tight text-dun-cream leading-[1.05]">
            Obras anteriores
          </h2>
        </div>
        <div class="md:col-span-4 md:text-right">
          <span class="inline-flex items-center gap-3 px-6 py-3.5 border border-dun-cream/40 group-hover:border-dun-cream group-hover:bg-dun-cream group-hover:text-dun-dark text-[11px] uppercase tracking-[0.25em] text-dun-cream transition-all duration-500 shadow-sm">
            <span>Ver obras anteriores</span>
            <span class="text-sm">→</span>
          </span>
        </div>
      </div>
    </a>
  </section>

  <!-- Empty state -->
  {
    allProjects.length === 0 && (
      <section class="max-w-7xl mx-auto px-6 py-20 text-center text-dun-muted">
        <p class="text-lg font-light">Próximamente.</p>
      </section>
    )
  }
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-goto]').forEach((a) => {
    a.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>(`[data-filter-btn="${a.dataset.goto}"]`)?.click();
    });
  });

  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
  const wraps = document.querySelectorAll<HTMLElement>('[data-project-wrap]');
  const on = ['bg-dun-cream', 'text-dun-dark', 'border-dun-cream', 'font-normal'];
  const off = ['text-dun-cream-dark', 'border-dun-cream/30', 'font-light'];

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filterBtn;
      filterBtns.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.remove(...(active ? off : on));
        b.classList.add(...(active ? on : off));
      });
      wraps.forEach((w) => {
        const card = w.querySelector<HTMLElement>('[data-project-card]');
        const visible = target === 'todos' || card?.dataset.group === target;
        w.style.display = visible ? '' : 'none';
      });
    });
  });
</script>

<style>
  /* Lexend has no native italic — use a refined synthesized slant only where we want a typographic accent */
  .italic-faux {
    font-style: italic;
  }

  /* Hide scrollbar for category pills on horizontal scroll */
  /* Ciclo de 39 s: cocina → baño → placard (13 s cada uno) */
  .plan .ln {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: plan-loop 39s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    animation-delay: calc(var(--g) * 13s + var(--d) * 0.25s + 0.2s);
  }
  .plan .plan-g > .ln:last-child {
    stroke: #cca067;
  }
  @keyframes plan-loop {
    0% { stroke-dashoffset: 1; }
    7%, 27% { stroke-dashoffset: 0; }
    33% { stroke-dashoffset: -1; }
    33.01%, 100% { stroke-dashoffset: 1; }
  }
  .cap {
    opacity: 0;
    visibility: hidden;
    animation: cap-cycle 39s linear infinite;
    animation-delay: calc(var(--g) * 13s + 1s);
  }
  @keyframes cap-cycle {
    0% { opacity: 0; visibility: visible; }
    3%, 28% { opacity: 1; visibility: visible; }
    32% { opacity: 0; visibility: visible; }
    32.01%, 100% { opacity: 0; visibility: hidden; }
  }

  /* Logo: se dibuja una sola vez */
  .logo .lg-b {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: lg-draw 1.4s ease-out 0.2s forwards;
  }
  .logo .lg-a {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: lg-draw 1.1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 0.6s + 0.9s);
  }
  .logo .lg-c,
  .logo .lg-f {
    opacity: 0;
    animation: plan-fade 1.2s ease forwards;
    animation-delay: 0.6s;
  }
  .logo .lg-f {
    animation-delay: 3s;
  }
  @keyframes lg-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes plan-fade {
    to { opacity: 1; }
  }
  .word {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .plan .plan-g:nth-child(n + 2) { display: none; }
    .plan .ln { animation: none; stroke-dashoffset: 0; }
    .cap { animation: none; opacity: 1; visibility: hidden; }
    .cap[style*="--g:0"] { visibility: visible; }
    .logo .lg-b, .logo .lg-a { animation: none; stroke-dashoffset: 0; }
    .logo .lg-c, .logo .lg-f { animation: none; opacity: 1; }
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
