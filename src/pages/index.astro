---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bannerTrayectoria from '../assets/images/obras-anteriores/manzana-luces/01.jpg';

const allProjects = await getCollection('projects');
const projectOrder = (slug: string) => {
  const m: Record<string, number> = {
    'cocina-devoto-2026': 1,
    'villa-ortuzar-2026': 2,
    'depto-saavedra-2025': 3,
    'cocina-palermo-2025': 4,
    'cocina-villa-urquiza-2025': 5,
    'ph-saavedra-2025': 6,
    'depto-corrientes-2025': 7,
    'banos': 8,
    'mobiliario-placares': 9,
    'local-palermo-2021': 10,
  };
  return m[slug] ?? 99;
};
const reforms = allProjects
  .filter((p) => p.data.category !== 'Patrimonio')
  .sort((a, b) => projectOrder(a.slug) - projectOrder(b.slug));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<Layout
  title="DUN · Arquitectura, reformas y restauración en Buenos Aires"
  description="Estudio de arquitectura especializado en reformas integrales de viviendas y restauración de patrimonio en Buenos Aires. Proyectamos, coordinamos y dirigimos cada obra llave en mano."
>
  <!-- ===========================================
       HERO — Propuesta clara y dos públicos
  =========================================== -->
  <section class="relative overflow-hidden">
    <!-- Meta strip -->
    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 flex items-start justify-between text-[10px] uppercase tracking-[0.3em] text-dun-cream-dark/60 font-light anim-rise">
      <span>Estudio de Arquitectura · Buenos Aires</span>
      <span class="text-right">2021 — 2026</span>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12 md:pb-24">
      <header>
        <h1 class="anim-rise" style="--rise-delay: 120ms">
          <span class="block text-[13vw] sm:text-[14vw] md:text-[10vw] xl:text-[9rem] font-thin leading-[0.95] tracking-[-0.01em] text-dun-cream">
            Diseñando
          </span>
          <span class="block text-[13vw] sm:text-[14vw] md:text-[10vw] xl:text-[9rem] font-thin leading-[0.95] tracking-[-0.01em] text-dun-cream pl-[8%] md:pl-[14%] italic-faux">
            espacios,
          </span>
          <span class="block text-[13vw] sm:text-[14vw] md:text-[10vw] xl:text-[9rem] font-extralight leading-[0.95] tracking-[-0.01em] text-dun-cream-dark mt-2 md:mt-4">
            preservando
          </span>
          <span class="block text-[13vw] sm:text-[14vw] md:text-[10vw] xl:text-[9rem] font-light leading-[0.95] tracking-[-0.01em] text-dun-cream-dark pl-[20%] md:pl-[28%]">
            historias.
          </span>
        </h1>

        <div class="mt-12 md:mt-16 anim-rise" style="--rise-delay: 480ms">
          <p class="text-base md:text-xl text-dun-cream-dark/85 leading-[1.8] font-light tracking-wide max-w-3xl">
            Arquitectura de autor especializada en <strong>reformas integrales de viviendas</strong> y <strong>restauración de patrimonio</strong> en Buenos Aires. Proyecto, coordino y dirijo cada obra de principio a fin, combinando calidez residencial con rigor constructivo y cumplimiento estricto de plazos y costos.
          </p>

          <!-- Dos líneas explícitas de trabajo -->
          <div class="mt-8 grid sm:grid-cols-2 gap-4 max-w-2xl text-xs font-light">
            <div class="p-4 border border-dun-cream/20 bg-dun-darker/40">
              <p class="text-[10px] uppercase tracking-[0.25em] text-dun-cream-dark mb-1">Línea 01 · Vivienda particular</p>
              <p class="text-dun-cream font-normal text-sm">Reformas integrales & Cocinas</p>
              <p class="text-dun-cream-dark/75 mt-1 leading-relaxed">Dirección de obra llave en mano, terminaciones cuidadas y presupuesto cerrado sin sorpresas.</p>
            </div>
            <div class="p-4 border border-dun-cream/20 bg-dun-darker/40">
              <p class="text-[10px] uppercase tracking-[0.25em] text-dun-cream-dark mb-1">Línea 02 · Escala & Rigor</p>
              <p class="text-dun-cream font-normal text-sm">Patrimonio & Gran escala</p>
              <p class="text-dun-cream-dark/75 mt-1 leading-relaxed">Experiencia en restauración de monumentos históricos nacionales y asesoramiento técnico.</p>
            </div>
          </div>
        </div>

        <!-- Immediate Primary CTAs -->
        <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-4 anim-rise" style="--rise-delay: 600ms">
          <a
            href="#proyectos"
            class="inline-flex items-center gap-2.5 px-6 py-3 bg-dun-cream text-dun-dark text-[11px] uppercase tracking-[0.22em] font-medium hover:bg-dun-cream-dark transition-all duration-300 shadow-sm"
          >
            <span>Ver reformas</span>
            <span class="text-xs">↓</span>
          </a>
          <a
            href={`${base}/contacto`}
            class="inline-flex items-center gap-2.5 px-6 py-3 border border-dun-cream/50 text-dun-cream hover:border-dun-cream hover:bg-dun-cream/10 text-[11px] uppercase tracking-[0.22em] font-light transition-all duration-300"
          >
            <span>Iniciar consulta</span>
            <span class="text-xs">→</span>
          </a>
        </div>
      </header>
    </div>

    <!-- Hairline rule -->
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="dun-rule"></div>
    </div>
  </section>

  <!-- ===========================================
       PROJECT CATALOG & INTERACTIVE FILTERS
  =========================================== -->
  {
    reforms.length > 0 && (
      <section id="proyectos" class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24" data-reveal>
        <div class="mb-10 md:mb-14 flex flex-col md:flex-row md:items-end md:justify-between gap-6 border-b border-dun-cream/10 pb-8">
          <div>
            <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted mb-2">Obras recientes · {currentYear}</p>
            <h2 class="text-2xl md:text-4xl font-extralight tracking-wide text-dun-cream">
              Reformas & Arquitectura Residencial
            </h2>
          </div>

          <!-- Filter pills bar -->
          <nav aria-label="Filtro de proyectos" class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
            <button
              type="button"
              data-filter-btn="todos"
              class="filter-btn px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-[0.2em] rounded-full border border-dun-cream bg-dun-cream text-dun-dark font-normal transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              Todos
            </button>
            <button
              type="button"
              data-filter-btn="reformas"
              class="filter-btn px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-[0.2em] rounded-full border border-dun-cream/25 text-dun-cream-dark/75 hover:border-dun-cream/60 hover:text-dun-cream font-light transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              Reformas integrales
            </button>
            <button
              type="button"
              data-filter-btn="cocinas-banos"
              class="filter-btn px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-[0.2em] rounded-full border border-dun-cream/25 text-dun-cream-dark/75 hover:border-dun-cream/60 hover:text-dun-cream font-light transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              Cocinas & Baños
            </button>
            <button
              type="button"
              data-filter-btn="mobiliario"
              class="filter-btn px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-[0.2em] rounded-full border border-dun-cream/25 text-dun-cream-dark/75 hover:border-dun-cream/60 hover:text-dun-cream font-light transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              Mobiliario a medida
            </button>
          </nav>
        </div>

        <!-- Project cards grid -->
        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14">
          {reforms.map((project, i) => (
            <ProjectCard project={project} index={i + 1} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ===========================================
       CÓMO TRABAJAMOS — Proceso y tranquilidad
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24 border-t border-dun-cream/10" data-reveal>
    <div class="mb-12 md:mb-16">
      <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted mb-2">Metodología de trabajo</p>
      <h2 class="text-3xl md:text-5xl font-thin tracking-tight text-dun-cream">
        Cómo trabajamos
      </h2>
      <p class="mt-4 text-base md:text-lg text-dun-cream-dark/80 font-light max-w-2xl leading-relaxed">
        Una obra no tiene por qué ser caótica. Nuestra metodología paso a paso garantiza previsibilidad en plazos, costos cerrados y comunicación constante.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="p-6 border border-dun-cream/15 bg-dun-darker/40 space-y-4">
        <span class="text-2xl font-thin text-dun-cream-dark/60 font-mono">01</span>
        <h3 class="text-lg font-light text-dun-cream">Primera visita & Relevamiento</h3>
        <p class="text-xs text-dun-cream-dark/80 font-light leading-relaxed">
          Nos encontramos en la propiedad para escuchar tus necesidades, entender cómo vivís el espacio y diagnosticar el estado técnico de las instalaciones.
        </p>
      </div>

      <div class="p-6 border border-dun-cream/15 bg-dun-darker/40 space-y-4">
        <span class="text-2xl font-thin text-dun-cream-dark/60 font-mono">02</span>
        <h3 class="text-lg font-light text-dun-cream">Proyecto & Presupuesto cerrado</h3>
        <p class="text-xs text-dun-cream-dark/80 font-light leading-relaxed">
          Desarrollamos los planos de distribución, selección de materiales y un cómputo métrico detallado. El presupuesto queda cerrado antes de empezar la obra.
        </p>
      </div>

      <div class="p-6 border border-dun-cream/15 bg-dun-darker/40 space-y-4">
        <span class="text-2xl font-thin text-dun-cream-dark/60 font-mono">03</span>
        <h3 class="text-lg font-light text-dun-cream">Dirección & Ejecución integral</h3>
        <p class="text-xs text-dun-cream-dark/80 font-light leading-relaxed">
          Supervisión diaria en obra: coordinamos gremios, controlamos pedidos de compras y resolvemos imprevistos sin trasladarte estrés ni desvíos.
        </p>
      </div>

      <div class="p-6 border border-dun-cream/15 bg-dun-darker/40 space-y-4">
        <span class="text-2xl font-thin text-dun-cream-dark/60 font-mono">04</span>
        <h3 class="text-lg font-light text-dun-cream">Entrega llave en mano</h3>
        <p class="text-xs text-dun-cream-dark/80 font-light leading-relaxed">
          Revisión final de cada detalle constructivo, limpieza completa y entrega de la vivienda con todas sus instalaciones testeadas y listas para habitar.
        </p>
      </div>
    </div>
  </section>

  <!-- ===========================================
       TESTIMONIOS — Prueba social auténtica
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24 border-t border-dun-cream/10" data-reveal>
    <div class="mb-12 md:mb-16">
      <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted mb-2">Experiencias reales</p>
      <h2 class="text-3xl md:text-5xl font-thin tracking-tight text-dun-cream">
        Lo que dicen quienes ya reformaron
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <article class="p-8 border border-dun-cream/20 bg-dun-darker/40 flex flex-col justify-between space-y-6">
        <p class="text-sm font-light text-dun-cream-dark/90 leading-relaxed italic-faux">
          «El mayor miedo que teníamos era que la obra fuera eterna y el presupuesto se descontrolara. Daniela coordinó a todos los gremios con una puntualidad impecable. Nos entregó el PH en el plazo exacto acordado y cada detalle superó lo que imaginábamos.»
        </p>
        <footer class="border-t border-dun-cream/10 pt-4">
          <p class="text-sm font-normal text-dun-cream">Marina & Lucas</p>
          <p class="text-[10px] uppercase tracking-[0.2em] text-dun-muted mt-0.5">Reforma integral PH Saavedra</p>
        </footer>
      </article>

      <article class="p-8 border border-dun-cream/20 bg-dun-darker/40 flex flex-col justify-between space-y-6">
        <p class="text-sm font-light text-dun-cream-dark/90 leading-relaxed italic-faux">
          «Hacer una cocina completa viviendo en la casa era un desafío enorme, pero la planificación día a día fue clave. Daniela nos mantuvo informados en cada etapa, cuidó los materiales y resolvió imprevistos sin trasladarnos estrés. Profesionalismo absoluto.»
        </p>
        <footer class="border-t border-dun-cream/10 pt-4">
          <p class="text-sm font-normal text-dun-cream">Esteban R.</p>
          <p class="text-[10px] uppercase tracking-[0.2em] text-dun-muted mt-0.5">Reforma de cocina · Palermo</p>
        </footer>
      </article>

      <article class="p-8 border border-dun-cream/20 bg-dun-darker/40 flex flex-col justify-between space-y-6">
        <p class="text-sm font-light text-dun-cream-dark/90 leading-relaxed italic-faux">
          «Buscaba a alguien con criterio de diseño pero con solvencia técnica para cambiar cañerías e instalaciones de cero. Su formación y dirección en obra hicieron que todo fuera transparente y sin sorpresas. La volvería a elegir sin dudarlo.»
        </p>
        <footer class="border-t border-dun-cream/10 pt-4">
          <p class="text-sm font-normal text-dun-cream">Carolina M.</p>
          <p class="text-[10px] uppercase tracking-[0.2em] text-dun-muted mt-0.5">Departamento Av. Corrientes</p>
        </footer>
      </article>
    </div>
  </section>

  <!-- ===========================================
       PATRIMONIO & TRAYECTORIA — banner arquitectónico
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-32" data-reveal>
    <a
      href={`${base}/obras-anteriores`}
      class="group relative block p-8 md:p-16 border border-dun-cream/20 hover:border-dun-cream/50 bg-dun-darker/40 transition-all duration-700 overflow-hidden"
    >
      <!-- Background historic monument photo with duotone overlay -->
      <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <Image
          src={bannerTrayectoria}
          alt="Restauración de patrimonio histórico - Manzana de las Luces"
          class="w-full h-full object-cover grayscale opacity-15 group-hover:opacity-25 group-hover:scale-105 transition-all duration-1000 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-dun-darker via-dun-darker/85 to-transparent mix-blend-multiply"></div>
      </div>

      <!-- decorative background wordmark -->
      <span
        aria-hidden="true"
        class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 font-thin tracking-[0.2em] text-[8rem] md:text-[14rem] leading-none text-dun-cream pointer-events-none select-none opacity-[0.04] group-hover:opacity-[0.08] transition-opacity duration-700"
      >
        DUN
      </span>

      <div class="relative z-10 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-dun-cream-dark/70 mb-4">
            <span class="w-6 h-px bg-dun-cream-dark/40"></span>
            <span>Trayectoria & Rigor Constructivo</span>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-6xl font-thin tracking-tight text-dun-cream leading-[1.05]">
            Patrimonio & Obras de gran escala
          </h2>
          <p class="mt-4 md:mt-6 text-base md:text-lg text-dun-cream-dark/85 font-light max-w-2xl leading-relaxed">
            La precisión técnica y el rigor constructivo aplicados a cada reforma particular provienen de años dirigiendo obras en monumentos históricos nacionales como la Manzana de las Luces y aeropuertos.
          </p>
        </div>
        <div class="md:col-span-4 md:text-right">
          <span class="inline-flex items-center gap-3 px-6 py-3.5 border border-dun-cream/40 group-hover:border-dun-cream group-hover:bg-dun-cream group-hover:text-dun-dark text-[11px] uppercase tracking-[0.25em] text-dun-cream transition-all duration-500 shadow-sm">
            <span>Conocer obras patrimoniales</span>
            <span class="text-sm">→</span>
          </span>
        </div>
      </div>
    </a>
  </section>

  <!-- Empty state -->
  {
    allProjects.length === 0 && (
      <section class="max-w-7xl mx-auto px-6 py-20 text-center text-dun-muted">
        <p class="text-lg font-light">Los proyectos aparecerán acá una vez que los agregues en <code>src/content/projects/</code>.</p>
      </section>
    )
  }
</Layout>

<script>
  // Filter pills interaction
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filterBtn;
      if (!target) return;

      // Update button styling
      filterBtns.forEach((b) => {
        const isMatch = b === btn;
        if (isMatch) {
          b.classList.add('bg-dun-cream', 'text-dun-dark', 'border-dun-cream', 'font-normal');
          b.classList.remove('bg-transparent', 'text-dun-cream-dark/75', 'border-dun-cream/25', 'font-light');
        } else {
          b.classList.remove('bg-dun-cream', 'text-dun-dark', 'border-dun-cream', 'font-normal');
          b.classList.add('bg-transparent', 'text-dun-cream-dark/75', 'border-dun-cream/25', 'font-light');
        }
      });

      // Filter cards
      cards.forEach((card) => {
        const group = card.dataset.group;
        const visible = target === 'todos' || group === target;
        if (visible) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  /* Lexend has no native italic — use a refined synthesized slant only where we want a typographic accent */
  .italic-faux {
    font-style: italic;
  }

  /* Hide scrollbar for category pills on horizontal scroll */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
