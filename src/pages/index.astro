---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { projectOrder } from '../lib/project-order';
import bannerTrayectoria from '../assets/images/obras-anteriores/manzana-luces/01.jpg';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => projectOrder(a.slug) - projectOrder(b.slug));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const filters = [
  { key: 'todos', label: 'Todos' },
  { key: 'cocinas', label: 'Cocinas' },
  { key: 'banos', label: 'Baños' },
  { key: 'reformas', label: 'Reformas' },
  { key: 'mobiliario', label: 'Mobiliario' },
  { key: 'comercial', label: 'Comercial' },
];
---

<Layout
  title="DUN · Estudio de arquitectura"
  description="DUN · Estudio de arquitectura en Buenos Aires. Obras y proyectos de Daniela Estevez Vredjian."
>
  <!-- Portada: planos que se dibujan solos (cocina, baño, placard) -->
  <section id="portada" class="relative w-full overflow-hidden bg-dun-darker h-[calc(100svh-4.25rem-5rem)] min-h-[440px]" aria-label="Portada">
