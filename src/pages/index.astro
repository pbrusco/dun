---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projectOrder = (slug: string) => {
  const m: Record<string, number> = {
    'cocina-devoto-2026': 1,
    'depto-saavedra-2025': 2,
    'cocina-palermo-2025': 3,
    'cocina-villa-urquiza-2025': 4,
    'ph-saavedra-2025': 5,
    'depto-corrientes-2025': 6,
    'local-palermo-2021': 7,
  };
  return m[slug] ?? 99;
};
const reforms = allProjects
  .filter((p) => p.data.category !== 'Patrimonio')
  .sort((a, b) => projectOrder(a.slug) - projectOrder(b.slug));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Proyectos">
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-10 md:pt-20 pb-8 md:pb-12">
    <header class="max-w-2xl">
      <h1 class="text-4xl md:text-6xl font-light leading-tight text-dun-cream tracking-wide">
        Diseñando espacios,<br />preservando historias.
      </h1>
      <p class="mt-6 text-lg text-dun-cream-dark leading-relaxed font-light tracking-wide">
        Arquitecta especializada en la reforma de viviendas y la restauración de patrimonio
        histórico en Buenos Aires. Proyecto, coordino y dirijo cada obra de principio a fin.
      </p>
      <p class="mt-2 text-sm text-dun-muted italic tracking-widest">
        encontramos la forma de hacer <span class="font-semibold not-italic text-dun-cream-dark">hogar</span>
      </p>
    </header>
  </section>

  <!-- Reformas -->
  {
    reforms.length > 0 && (
      <section class="max-w-7xl mx-auto px-6 py-12">
        <h2 class="text-xs uppercase tracking-widest text-dun-muted mb-8">
          Reformas & Interiorismo
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {reforms.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Obras anteriores CTA -->
  <section class="max-w-7xl mx-auto px-6 py-12">
    <a
      href={`${base}/obras-anteriores`}
      class="group block border border-dun-darker hover:border-dun-muted transition p-8 md:p-12"
    >
      <p class="text-xs uppercase tracking-widest text-dun-muted mb-3">Trayectoria</p>
      <h2 class="text-2xl md:text-3xl font-light tracking-wide text-dun-cream group-hover:text-white transition">
        Obras anteriores
      </h2>
      <p class="mt-3 text-dun-cream-dark font-light max-w-2xl">
        Restauración de patrimonio, aeropuertos y obras de gran escala realizadas junto
        a constructoras y estudios.
      </p>
      <div class="mt-6 text-xs font-light tracking-widest uppercase text-dun-muted flex items-center gap-1.5">
        Ver galería
        <span class="group-hover:translate-x-1 transition-transform inline-block">→</span>
      </div>
    </a>
  </section>

  <!-- Empty state -->
  {
    allProjects.length === 0 && (
      <section class="max-w-7xl mx-auto px-6 py-20 text-center text-dun-muted">
        <p class="text-lg font-light">Los proyectos aparecerán acá una vez que los agregues en <code>src/content/projects/</code>.</p>
      </section>
    )
  }
</Layout>
