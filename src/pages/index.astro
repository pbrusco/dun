<script>
  const heroEl = document.getElementById('portada');
  const pauseBtn = document.getElementById('hero-pause');
  let userPaused = false;
  let inView = true;
  const applyPause = () => heroEl?.classList.toggle('is-paused', userPaused || !inView);
  pauseBtn?.addEventListener('click', () => {
    userPaused = !userPaused;
    pauseBtn.setAttribute('aria-pressed', String(userPaused));
    pauseBtn.querySelector('.pause-ico')?.classList.toggle('hidden', userPaused);
    pauseBtn.querySelector('.play-ico')?.classList.toggle('hidden', !userPaused);
    applyPause();
  });
  if (heroEl) {
    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      applyPause();
    }).observe(heroEl);
  }
  document.querySelectorAll<HTMLElement>('[data-goto]').forEach((a) => {
    a.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>(`[data-filter-btn="${a.dataset.goto}"]`)?.click();
    });
  });

  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
  const wraps = document.querySelectorAll<HTMLElement>('[data-project-wrap]');
  const on = ['bg-dun-cream', 'text-dun-dark', 'border-dun-cream', 'font-normal'];
  const off = ['text-dun-cream-dark', 'border-dun-cream/30', 'font-light'];

  const status = document.getElementById('filter-status');
  const apply = (target: string) => {
    let n = 0;
    filterBtns.forEach((b) => {
      const active = b.dataset.filterBtn === target;
      b.setAttribute('aria-pressed', String(active));
      b.classList.remove(...(active ? off : on));
      b.classList.add(...(active ? on : off));
    });
    wraps.forEach((w) => {
      const card = w.querySelector<HTMLElement>('[data-project-card]');
      const visible = target === 'todos' || card?.dataset.group === target;
      w.style.display = visible ? '' : 'none';
      if (visible) n++;
    });
    if (status) status.textContent = `${n} obras`;
  };

  // El filtro vive en la URL (?f=cocinas) para poder compartirlo.
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filterBtn!;
      apply(target);
      history.replaceState(null, '', target === 'todos' ? location.pathname : `?f=${target}`);
    });
  });
  const initial = new URLSearchParams(location.search).get('f');
  if (initial && [...filterBtns].some((b) => b.dataset.filterBtn === initial)) apply(initial);
</script>

