---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bannerTrayectoria from '../assets/images/obras-anteriores/manzana-luces/01.jpg';

const allProjects = await getCollection('projects');
const projectOrder = (slug: string) => {
  const m: Record<string, number> = {
    'cocina-devoto-2026': 1,
    'villa-ortuzar-2026': 2,
    'bano-caballito-2026': 3,
    'bano-barracas-2026': 4,
    'depto-saavedra-2025': 5,
    'cocina-palermo-2025': 6,
    'cocina-villa-urquiza-2025': 7,
    'ph-saavedra-2025': 8,
    'depto-corrientes-2025': 9,
    'bano-ph-saavedra-2025': 10,
    'bano-palermo-2025': 11,
    'bano-olivos-2025': 12,
    'placard-villa-urquiza-2025': 13,
    'placard-villa-pueyrredon-2025': 14,
    'local-palermo-2021': 15,
  };
  return m[slug] ?? 99;
};
const reforms = allProjects
  .filter((p) => p.data.category !== 'Patrimonio')
  .sort((a, b) => projectOrder(a.slug) - projectOrder(b.slug));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<Layout
  title="DUN · Estudio de arquitectura"
  description="DUN · Estudio de arquitectura en Buenos Aires. Obras y proyectos de Daniela Estevez Vredjian."
>
  <!-- ===========================================
       HERO — Propuesta clara y dos públicos
  =========================================== -->
  <section class="relative overflow-hidden">
    <!-- Meta strip -->
    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 flex items-start justify-between text-[10px] uppercase tracking-[0.3em] text-dun-cream-dark/60 font-light anim-rise">
      <span>Estudio de Arquitectura · Buenos Aires</span>
      <span class="text-right">2021 — 2026</span>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12 md:pb-24">
      <header>
        <h1 class="anim-rise" style="--rise-delay: 120ms">
          <span class="block text-[22vw] md:text-[14vw] xl:text-[12rem] font-thin leading-[0.95] tracking-[0.04em] text-dun-cream">
            DUN
          </span>
          <span class="block mt-4 text-[5vw] md:text-[2vw] xl:text-3xl font-extralight tracking-[0.2em] uppercase text-dun-cream-dark">
            Estudio de arquitectura
          </span>
        </h1>

        <!-- Immediate Primary CTAs -->
        <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-4 anim-rise" style="--rise-delay: 600ms">
          <a
            href="#proyectos"
            class="inline-flex items-center gap-2.5 px-6 py-3 bg-dun-cream text-dun-dark text-[11px] uppercase tracking-[0.22em] font-medium hover:bg-dun-cream-dark transition-all duration-300 shadow-sm"
          >
            <span>Ver obras</span>
            <span class="text-xs">↓</span>
          </a>
          <a
            href={`${base}/contacto`}
            class="inline-flex items-center gap-2.5 px-6 py-3 border border-dun-cream/50 text-dun-cream hover:border-dun-cream hover:bg-dun-cream/10 text-[11px] uppercase tracking-[0.22em] font-light transition-all duration-300"
          >
            <span>Iniciar consulta</span>
            <span class="text-xs">→</span>
          </a>
        </div>
      </header>
    </div>

    <!-- Hairline rule -->
    <div class="max-w-7xl mx-auto px-6 md:px-10">
      <div class="dun-rule"></div>
    </div>
  </section>

  <!-- ===========================================
       PROJECT CATALOG & INTERACTIVE FILTERS
  =========================================== -->
  {
    reforms.length > 0 && (
      <section id="proyectos" class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24" data-reveal>
        <div class="mb-10 md:mb-14 flex flex-col md:flex-row md:items-end md:justify-between gap-6 border-b border-dun-cream/10 pb-8">
          <div>
            <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted mb-2">Proyectos</p>
            <h2 class="text-2xl md:text-4xl font-extralight tracking-wide text-dun-cream">
              Obras
            </h2>
          </div>

          <!-- Filter pills bar -->
          <nav aria-label="Filtro de proyectos" class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
            <button
              type="button"
              data-filter-btn="todos"
              class="filter-btn px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-[0.2em] rounded-full border border-dun-cream bg-dun-cream text-dun-dark font-normal transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              Todos
            </button>
            <button
              type="button"
              data-filter-btn="reformas"
              class="filter-btn px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-[0.2em] rounded-full border border-dun-cream/25 text-dun-cream-dark/75 hover:border-dun-cream/60 hover:text-dun-cream font-light transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              Reformas integrales
            </button>
            <button
              type="button"
              data-filter-btn="cocinas-banos"
              class="filter-btn px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-[0.2em] rounded-full border border-dun-cream/25 text-dun-cream-dark/75 hover:border-dun-cream/60 hover:text-dun-cream font-light transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              Cocinas & Baños
            </button>
            <button
              type="button"
              data-filter-btn="mobiliario"
              class="filter-btn px-4 py-1.5 text-[10px] md:text-[11px] uppercase tracking-[0.2em] rounded-full border border-dun-cream/25 text-dun-cream-dark/75 hover:border-dun-cream/60 hover:text-dun-cream font-light transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              Mobiliario a medida
            </button>
          </nav>
        </div>

        <!-- Project cards grid -->
        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14">
          {reforms.map((project, i) => (
            <ProjectCard project={project} index={i + 1} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ===========================================
       PATRIMONIO & TRAYECTORIA — banner arquitectónico
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-32" data-reveal>
    <a
      href={`${base}/obras-anteriores`}
      class="group relative block p-8 md:p-16 border border-dun-cream/20 hover:border-dun-cream/50 bg-dun-darker/40 transition-all duration-700 overflow-hidden"
    >
      <!-- Background historic monument photo with duotone overlay -->
      <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <Image
          src={bannerTrayectoria}
          alt="Restauración de patrimonio histórico - Manzana de las Luces"
          class="w-full h-full object-cover grayscale opacity-15 group-hover:opacity-25 group-hover:scale-105 transition-all duration-1000 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-dun-darker via-dun-darker/85 to-transparent mix-blend-multiply"></div>
      </div>

      <!-- decorative background wordmark -->
      <span
        aria-hidden="true"
        class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 font-thin tracking-[0.2em] text-[8rem] md:text-[14rem] leading-none text-dun-cream pointer-events-none select-none opacity-[0.04] group-hover:opacity-[0.08] transition-opacity duration-700"
      >
        DUN
      </span>

      <div class="relative z-10 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-dun-cream-dark/70 mb-4">
            <span class="w-6 h-px bg-dun-cream-dark/40"></span>
            <span>Trayectoria</span>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-6xl font-thin tracking-tight text-dun-cream leading-[1.05]">
            Obras anteriores
          </h2>
        </div>
        <div class="md:col-span-4 md:text-right">
          <span class="inline-flex items-center gap-3 px-6 py-3.5 border border-dun-cream/40 group-hover:border-dun-cream group-hover:bg-dun-cream group-hover:text-dun-dark text-[11px] uppercase tracking-[0.25em] text-dun-cream transition-all duration-500 shadow-sm">
            <span>Ver obras anteriores</span>
            <span class="text-sm">→</span>
          </span>
        </div>
      </div>
    </a>
  </section>

  <!-- Empty state -->
  {
    allProjects.length === 0 && (
      <section class="max-w-7xl mx-auto px-6 py-20 text-center text-dun-muted">
        <p class="text-lg font-light">Próximamente.</p>
      </section>
    )
  }
</Layout>

<script>
  // Filter pills interaction
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filterBtn;
      if (!target) return;

      // Update button styling
      filterBtns.forEach((b) => {
        const isMatch = b === btn;
        if (isMatch) {
          b.classList.add('bg-dun-cream', 'text-dun-dark', 'border-dun-cream', 'font-normal');
          b.classList.remove('bg-transparent', 'text-dun-cream-dark/75', 'border-dun-cream/25', 'font-light');
        } else {
          b.classList.remove('bg-dun-cream', 'text-dun-dark', 'border-dun-cream', 'font-normal');
          b.classList.add('bg-transparent', 'text-dun-cream-dark/75', 'border-dun-cream/25', 'font-light');
        }
      });

      // Filter cards
      cards.forEach((card) => {
        const group = card.dataset.group;
        const visible = target === 'todos' || group === target;
        if (visible) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  /* Lexend has no native italic — use a refined synthesized slant only where we want a typographic accent */
  .italic-faux {
    font-style: italic;
  }

  /* Hide scrollbar for category pills on horizontal scroll */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
