---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import bannerTrayectoria from '../assets/images/obras-anteriores/manzana-luces/01.jpg';

const allProjects = await getCollection('projects');
const projectOrder = (slug: string) => {
  const m: Record<string, number> = {
    'cocina-devoto-2026': 1,
    'villa-ortuzar-2026': 2,
    'bano-caballito-2026': 3,
    'bano-barracas-2026': 4,
    'depto-saavedra-2025': 5,
    'cocina-palermo-2025': 6,
    'cocina-villa-urquiza-2025': 7,
    'ph-saavedra-2025': 8,
    'depto-corrientes-2025': 9,
    'bano-ph-saavedra-2025': 10,
    'bano-palermo-2025': 11,
    'bano-olivos-2025': 12,
    'placard-villa-urquiza-2025': 13,
    'placard-villa-pueyrredon-2025': 14,
    'local-palermo-2021': 15,
  };
  return m[slug] ?? 99;
};
const projects = allProjects.sort((a, b) => projectOrder(a.slug) - projectOrder(b.slug));

const heroProjects = projects.slice(0, 5);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const filters = [
  { key: 'todos', label: 'Todos' },
  { key: 'cocinas', label: 'Cocinas' },
  { key: 'banos', label: 'Baños' },
  { key: 'reformas', label: 'Reformas' },
  { key: 'mobiliario', label: 'Mobiliario' },
  { key: 'comercial', label: 'Comercial' },
];
---

<Layout
  title="DUN · Estudio de arquitectura"
  description="DUN · Estudio de arquitectura en Buenos Aires. Obras y proyectos de Daniela Estevez Vredjian."
>
  <!-- Portada: obras recientes a pantalla completa -->
  <section id="portada" class="relative w-full overflow-hidden bg-dun-darker h-[calc(100svh-4rem)] min-h-[480px]" aria-label="Obras destacadas">
    {heroProjects.map((p, i) => (
      <a
        href={`${base}/projects/${p.slug}`}
        data-hero-slide
        aria-hidden={i === 0 ? 'false' : 'true'}
        tabindex={i === 0 ? 0 : -1}
        class:list={['absolute inset-0 block transition-opacity duration-[1400ms] ease-in-out', i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none']}
      >
        <Image
          src={p.data.cover}
          alt={p.data.title}
          widths={[640, 1024, 1600]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          class="hero-img absolute inset-0 w-full h-full object-cover"
        />
      </a>
    ))}
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-dun-darker via-dun-darker/40 to-dun-darker/10"></div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-24">
      <h1 class="anim-rise">
        <span class="block text-6xl md:text-8xl font-thin tracking-[0.06em] text-dun-cream">DUN</span>
        <span class="block mt-2 text-[11px] md:text-sm font-extralight tracking-[0.25em] uppercase text-dun-cream">Estudio de arquitectura · Buenos Aires</span>
      </h1>
      <p class="mt-6 text-[11px] uppercase tracking-[0.25em] text-dun-cream-dark" aria-live="off">
        {heroProjects.map((p, i) => (
          <span data-hero-caption class:list={[i === 0 ? '' : 'hidden']}>{[p.data.title, p.data.year].filter(Boolean).join(' · ')}</span>
        ))}
      </p>
    </div>

    <div class="absolute inset-x-0 bottom-0 max-w-7xl mx-auto px-6 md:px-10 pb-5 flex items-center justify-between">
      <div class="flex items-center">
        {heroProjects.map((p, i) => (
          <button type="button" data-hero-dot={i} aria-label={`Ver ${p.data.title}`} aria-current={i === 0 ? 'true' : 'false'} class="group w-11 h-11 flex items-center justify-center cursor-pointer">
            <span class="block h-px w-6 bg-dun-cream/40 group-aria-[current=true]:bg-dun-cream transition-colors"></span>
          </button>
        ))}
      </div>
      <a href="#proyectos" class="inline-flex items-center gap-2 min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream hover:text-white transition">
        Ver obras <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <!-- Obras -->
  {
    projects.length > 0 && (
      <section id="proyectos" class="max-w-7xl mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-16 md:pb-24 scroll-mt-16">
        <nav aria-label="Filtro de obras" class="mb-8 md:mb-12 flex items-center gap-2 overflow-x-auto no-scrollbar -mx-6 px-6 md:mx-0 md:px-0 py-1">
          {filters.map((f, i) => (
            <button
              type="button"
              data-filter-btn={f.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class:list={[
                'filter-btn px-4 min-h-11 text-[11px] uppercase tracking-[0.2em] rounded-full border transition-all duration-300 cursor-pointer whitespace-nowrap',
                i === 0
                  ? 'border-dun-cream bg-dun-cream text-dun-dark font-normal'
                  : 'border-dun-cream/30 text-dun-cream-dark hover:border-dun-cream/60 hover:text-dun-cream font-light',
              ]}
            >
              {f.label}
            </button>
          ))}
        </nav>

        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 md:gap-x-8 gap-y-12 md:gap-y-14">
          {projects.map((project, i) => (
            <div class={i === 0 ? 'md:col-span-2 lg:col-span-3' : ''} data-project-wrap>
              <ProjectCard project={project} index={i + 1} variant={i === 0 ? 'featured' : 'default'} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ===========================================
       PATRIMONIO & TRAYECTORIA — banner arquitectónico
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20 md:pb-32" data-reveal>
    <a
      href={`${base}/obras-anteriores`}
      class="group relative block p-8 md:p-16 border border-dun-cream/20 hover:border-dun-cream/50 bg-dun-darker/40 transition-all duration-700 overflow-hidden"
    >
      <!-- Background historic monument photo with duotone overlay -->
      <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <Image
          src={bannerTrayectoria}
          alt="Restauración de patrimonio histórico - Manzana de las Luces"
          class="w-full h-full object-cover grayscale opacity-15 group-hover:opacity-25 group-hover:scale-105 transition-all duration-1000 ease-out"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-dun-darker via-dun-darker/85 to-transparent mix-blend-multiply"></div>
      </div>

      <!-- decorative background wordmark -->
      <span
        aria-hidden="true"
        class="absolute right-4 md:right-10 top-1/2 -translate-y-1/2 font-thin tracking-[0.2em] text-[8rem] md:text-[14rem] leading-none text-dun-cream pointer-events-none select-none opacity-[0.04] group-hover:opacity-[0.08] transition-opacity duration-700"
      >
        DUN
      </span>

      <div class="relative z-10 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <div class="flex items-center gap-3 text-[10px] uppercase tracking-[0.3em] text-dun-cream-dark mb-4">
            <span class="w-6 h-px bg-dun-cream-dark/40"></span>
            <span>Trayectoria</span>
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-6xl font-thin tracking-tight text-dun-cream leading-[1.05]">
            Obras anteriores
          </h2>
        </div>
        <div class="md:col-span-4 md:text-right">
          <span class="inline-flex items-center gap-3 px-6 py-3.5 border border-dun-cream/40 group-hover:border-dun-cream group-hover:bg-dun-cream group-hover:text-dun-dark text-[11px] uppercase tracking-[0.25em] text-dun-cream transition-all duration-500 shadow-sm">
            <span>Ver obras anteriores</span>
            <span class="text-sm">→</span>
          </span>
        </div>
      </div>
    </a>
  </section>

  <!-- Empty state -->
  {
    allProjects.length === 0 && (
      <section class="max-w-7xl mx-auto px-6 py-20 text-center text-dun-muted">
        <p class="text-lg font-light">Próximamente.</p>
      </section>
    )
  }
</Layout>

<script>

  const slides = document.querySelectorAll<HTMLElement>('[data-hero-slide]');
  const dots = document.querySelectorAll<HTMLButtonElement>('[data-hero-dot]');
  const caps = document.querySelectorAll<HTMLElement>('[data-hero-caption]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cur = 0;
  let timer: number | undefined;
  const show = (n: number) => {
    cur = (n + slides.length) % slides.length;
    slides.forEach((el, i) => {
      const on = i === cur;
      el.classList.toggle('opacity-100', on);
      el.classList.toggle('opacity-0', !on);
      el.classList.toggle('pointer-events-none', !on);
      el.setAttribute('aria-hidden', String(!on));
      el.tabIndex = on ? 0 : -1;
    });
    dots.forEach((d, i) => d.setAttribute('aria-current', String(i === cur)));
    caps.forEach((c, i) => c.classList.toggle('hidden', i !== cur));
  };
  const start = () => {
    if (reduce || slides.length < 2) return;
    stop();
    timer = window.setInterval(() => show(cur + 1), 5500);
  };
  const stop = () => { if (timer) window.clearInterval(timer); };
  dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  start();
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
  const wraps = document.querySelectorAll<HTMLElement>('[data-project-wrap]');
  const on = ['bg-dun-cream', 'text-dun-dark', 'border-dun-cream', 'font-normal'];
  const off = ['text-dun-cream-dark', 'border-dun-cream/30', 'font-light'];

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filterBtn;
      filterBtns.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.remove(...(active ? off : on));
        b.classList.add(...(active ? on : off));
      });
      wraps.forEach((w) => {
        const card = w.querySelector<HTMLElement>('[data-project-card]');
        const visible = target === 'todos' || card?.dataset.group === target;
        w.style.display = visible ? '' : 'none';
      });
    });
  });
</script>

<style>
  /* Lexend has no native italic — use a refined synthesized slant only where we want a typographic accent */
  .italic-faux {
    font-style: italic;
  }

  /* Hide scrollbar for category pills on horizontal scroll */
  @keyframes hero-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }
  .hero-img {
    animation: hero-zoom 12s ease-out both;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-img { animation: none; }
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
