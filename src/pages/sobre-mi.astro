---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import dani from '../assets/images/dani.jpeg';
import uba from '../assets/images/uba.jpeg';
---

<Layout
  title="Sobre mí"
  description="Daniela Estevez Vredjian, arquitecta. DUN · Estudio de arquitectura en Buenos Aires."
>

  <!-- ===========================================
       HERO — name + role + portrait
  =========================================== -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 flex items-start justify-between text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark font-light anim-rise">
      <span>Estudio · Daniela Estevez Vredjian</span>
      <span class="hidden md:inline">Arquitecta</span>
      <span>Buenos Aires · AR</span>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-20 pb-12 md:pb-20 grid grid-cols-12 gap-y-10 md:gap-x-10">
      <!-- Title block -->
      <div class="col-span-12 md:col-span-8 order-2 md:order-1">
        <p class="anim-rise text-[11px] uppercase tracking-[0.3em] text-dun-muted mb-4" style="--rise-delay: 60ms">Estudio</p>
        <h1 class="anim-rise" style="--rise-delay: 140ms">
          <span class="block text-[11vw] sm:text-[12vw] md:text-[8vw] xl:text-[7.5rem] font-thin leading-[0.9] tracking-[-0.02em] text-dun-cream">
            Daniela
          </span>
          <span class="block text-[11vw] sm:text-[12vw] md:text-[8vw] xl:text-[7.5rem] font-light leading-[0.9] tracking-[-0.02em] text-dun-cream-dark pl-[14%] md:pl-[22%]">
            Estevez Vredjian.
          </span>
        </h1>

        <p class="mt-8 md:mt-10 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark font-light anim-rise" style="--rise-delay: 280ms">
          Arquitecta · MP UBA · Posgrado en Patrimonio
        </p>
      </div>

      <!-- Portrait -->
      <div class="col-span-12 md:col-span-4 order-1 md:order-2 anim-rise" style="--rise-delay: 340ms">
        <figure class="relative max-w-xs mx-auto md:max-w-none md:ml-auto">
          <div class="absolute -inset-2 border border-dun-cream-dark/30"></div>
          <Image
            src={dani}
            alt="Daniela Estevez Vredjian · Arquitecta"
            class="relative w-full aspect-[4/5] object-cover object-center"
          />
        </figure>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10"><div class="dun-rule"></div></div>
  </section>

  <!-- ===========================================
       PROPUESTA / FILOSOFÍA
  =========================================== -->
  <section class="max-w-5xl mx-auto px-6 md:px-10 py-16 md:py-28" data-reveal>
    <p class="text-[11px] uppercase tracking-[0.3em] text-dun-muted mb-6">Filosofía de trabajo</p>
    <p class="text-2xl md:text-4xl xl:text-5xl font-light leading-[1.2] tracking-tight text-dun-cream">
      Me especializo en la <span class="text-dun-cream-dark">remodelación y ejecución</span>
      de obras de vivienda. Coordino cada etapa del proceso, desde el proyecto inicial hasta el final de obra y entrega, para que el resultado sea <span class="italic-faux text-dun-cream">exactamente lo que imaginamos juntos.</span>
    </p>
  </section>

  <div class="max-w-7xl mx-auto px-6 md:px-10"><div class="dun-rule"></div></div>

  <!-- ===========================================
       SERVICIOS (según SOBRE MI.docx)
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24" data-reveal>
    <div class="grid grid-cols-12 gap-y-8 md:gap-x-10">
      <div class="col-span-12 md:col-span-4">
        <p class="text-[11px] uppercase tracking-[0.3em] text-dun-muted mb-2">Especialidades</p>
        <h2 class="text-2xl md:text-3xl font-light text-dun-cream">Servicios</h2>
      </div>
      <ul class="col-span-12 md:col-span-8 space-y-3 text-base font-light text-dun-cream-dark">
        <li>Reforma integral de viviendas: cocinas, baños, departamentos y PH</li>
        <li>Asesoría técnica</li>
        <li>Restauración y puesta en valor de edificios patrimoniales</li>
        <li>Certificado de conservación de fachadas · Informe de Evaluación del Edificio</li>
        <li>Proyecto y documentación de obra</li>
        <li>Inspección técnica y elaboración de informes</li>
        <li>Coordinación y planificación de obra</li>
      </ul>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-6 md:px-10"><div class="dun-rule"></div></div>

  <!-- ===========================================
       FEATURED LARGE-SCALE PROJECTS
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24" data-reveal>
    <div class="grid grid-cols-12 gap-y-10 md:gap-x-10">
      <div class="col-span-12 md:col-span-4">
        <p class="text-[11px] uppercase tracking-[0.3em] text-dun-muted mb-2">Trayectoria institucional</p>
        <h2 class="text-2xl md:text-3xl font-light text-dun-cream">Obras de gran escala</h2>
        <p class="mt-3 text-[11px] uppercase tracking-[0.25em] text-dun-muted max-w-xs leading-relaxed">
          Colaboraciones con empresas constructoras y con el Ministerio de Cultura.
        </p>
      </div>
      <ul class="col-span-12 md:col-span-8 space-y-7">
        {[
          { title: 'Manzana de las Luces', body: 'Restauración de fachadas y cubiertas del Edificio Ex Procuraduría y Ex Casas Redituantes. Ministerio de Cultura de la Nación.' },
          { title: 'Instituto Nacional Sanmartiniano', body: 'Restauración de carpinterías.' },
          { title: 'Aeroparque J. Newbery', body: 'Remodelación integral de baños preembarque y reparación de cubiertas.' },
          { title: 'Aeropuerto Ministro Pistarini · Ezeiza', body: 'Instalaciones.' },
        ].map((p) => (
          <li>
            <h3 class="text-xl md:text-2xl font-light tracking-wide text-dun-cream">{p.title}</h3>
            <p class="mt-2 text-dun-cream-dark font-light leading-relaxed max-w-2xl">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-6 md:px-10"><div class="dun-rule"></div></div>

  <!-- ===========================================
       FORMATION + COVERAGE
  =========================================== -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24" data-reveal>
    <div class="grid grid-cols-12 gap-y-12 md:gap-x-10">
      <div class="col-span-12 md:col-span-6">
        <p class="text-[11px] uppercase tracking-[0.3em] text-dun-muted mb-6">Formación</p>
        <div class="flex items-start gap-5 md:gap-7">
          <Image
            src={uba}
            alt="Universidad de Buenos Aires"
            class="w-14 h-14 md:w-16 md:h-16 object-contain opacity-80 flex-shrink-0"
          />
          <ul class="space-y-4 text-sm md:text-base font-light text-dun-cream-dark">
            <li>
              <span class="text-dun-cream font-normal">Maestro Mayor de Obras</span>
            </li>
            <li>
              <span class="text-dun-cream font-normal">Universidad de Buenos Aires</span>
              <span class="block text-dun-cream-dark">Arquitecta</span>
              <span class="block text-[11px] uppercase tracking-[0.3em] text-dun-muted mt-1">Me recibí en 2017</span>
            </li>
            <li>
              <span class="text-dun-cream font-normal">Universidad de Buenos Aires</span>
              <span class="block text-dun-cream-dark">Posgrado en Conservación Integral y Rehabilitación del Patrimonio Arquitectónico</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
    </div>
  </section>

  <!-- ===========================================
       CONTACT
  =========================================== -->
  <section id="contacto" class="border-t border-dun-cream/10 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-28" data-reveal>
      <div class="grid grid-cols-12 gap-y-8 md:gap-x-10 items-end">
        <div class="col-span-12 md:col-span-7">
          <p class="text-[11px] uppercase tracking-[0.3em] text-dun-muted mb-6">Contacto</p>
          <p class="text-3xl md:text-5xl xl:text-6xl font-light text-dun-cream leading-[1.05] tracking-tight">
            ¿Pensando en una<br/>
            <span class="text-dun-cream-dark italic-faux">obra</span>?
            <br/>Conversemos.
          </p>
        </div>
        <div class="col-span-12 md:col-span-5">
          <a
            href="https://wa.me/5491162374256?text=Hola%20Daniela,%20me%20gustar%C3%ADa%20consultarte%20por%20un%20proyecto"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 border border-dun-cream text-dun-cream px-6 py-4 md:px-8 md:py-5 text-[11px] uppercase tracking-[0.3em] hover:bg-dun-cream hover:text-dun-dark transition-all duration-300 group"
          >
            <span>Escribirme por WhatsApp</span>
            <span class="block w-6 h-px bg-current group-hover:w-10 transition-all duration-300"></span>
          </a>
          <div class="mt-6 space-y-2.5 text-sm font-light">
            <p class="flex items-center gap-3 text-dun-cream-dark">
              <span class="text-[11px] uppercase tracking-[0.25em] text-dun-muted w-24 shrink-0">WhatsApp</span>
              <a href="https://wa.me/5491162374256" target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 text-dun-cream hover:underline">
                +54 9 11 6237-4256
              </a>
            </p>
            <p class="flex items-center gap-3 text-dun-cream-dark">
              <span class="text-[11px] uppercase tracking-[0.25em] text-dun-muted w-24 shrink-0">Email</span>
              <a href="mailto:hola.dun.arquitectura@gmail.com" class="inline-flex items-center min-h-11 text-dun-cream hover:underline">
                hola.dun.arquitectura@gmail.com
              </a>
            </p>
            <p class="flex items-center gap-3 text-dun-cream-dark">
              <span class="text-[11px] uppercase tracking-[0.25em] text-dun-muted w-24 shrink-0">Instagram</span>
              <a href="https://www.instagram.com/dun.arquitectura/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 text-dun-cream hover:underline">
                @dun.arquitectura
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .italic-faux { font-style: italic; }
</style>
