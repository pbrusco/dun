---
import Layout from '../layouts/Layout.astro';
import { Image, getImage } from 'astro:assets';
import Lightbox from '../components/Lightbox.astro';

// Manzana de las Luces
import mll1 from '../assets/images/obras-anteriores/manzana-luces/01.jpg';
import mll2 from '../assets/images/obras-anteriores/manzana-luces/02-antes.jpg';
import mll3 from '../assets/images/obras-anteriores/manzana-luces/03-proceso.jpg';
import mll4 from '../assets/images/obras-anteriores/manzana-luces/04.jpg';
import mll5 from '../assets/images/obras-anteriores/manzana-luces/05.jpg';
import mll6 from '../assets/images/obras-anteriores/manzana-luces/06.jpg';

// Instituto Nacional Sanmartiniano
import sm1 from '../assets/images/obras-anteriores/sanmartiniano/01.jpg';
import sm2 from '../assets/images/obras-anteriores/sanmartiniano/02.jpg';
import sm3 from '../assets/images/obras-anteriores/sanmartiniano/03.jpg';
import sm4 from '../assets/images/obras-anteriores/sanmartiniano/04.jpg';
import sm5 from '../assets/images/obras-anteriores/sanmartiniano/05.jpg';

// Aeroparque Newbery
import an1 from '../assets/images/obras-anteriores/aeroparque-newbery/01.jpg';
import an2 from '../assets/images/obras-anteriores/aeroparque-newbery/02.jpg';
import an3 from '../assets/images/obras-anteriores/aeroparque-newbery/03.jpg';
import an4 from '../assets/images/obras-anteriores/aeroparque-newbery/04.jpg';

// Aeropuerto Ezeiza
import ez1 from '../assets/images/obras-anteriores/aeropuerto-ezeiza/01.jpg';
import ez2 from '../assets/images/obras-anteriores/aeropuerto-ezeiza/02.jpg';
import ez3 from '../assets/images/obras-anteriores/aeropuerto-ezeiza/03.jpg';
import ez4 from '../assets/images/obras-anteriores/aeropuerto-ezeiza/04.jpg';

// Gimnasios Fitter
import gf1 from '../assets/images/obras-anteriores/gimnasios-fitter/01.jpg';
import gf2 from '../assets/images/obras-anteriores/gimnasios-fitter/02.jpg';
import gf3 from '../assets/images/obras-anteriores/gimnasios-fitter/03.jpg';
import gf4 from '../assets/images/obras-anteriores/gimnasios-fitter/04.jpg';

const sections = [
  {
    id: 'manzana-luces',
    year: '2022–2023',
    title: 'Manzana de las Luces',
    kicker: 'Patrimonio',
    description:
      'Restauración de envolvente edilicia, fachadas y cubiertas del Edificio Ex Procuraduría y Ex Casas Redituantes (Ministerio de Cultura de la Nación).',
    images: [mll1, mll2, mll3, mll4, mll5, mll6],
  },
  {
    id: 'sanmartiniano',
    year: '2024',
    title: 'Instituto Nacional Sanmartiniano',
    kicker: 'Patrimonio',
    description: 'Restauración de carpinterías de madera.',
    images: [sm1, sm2, sm3, sm4, sm5],
  },
  {
    id: 'aeroparque-newbery',
    year: '2024',
    title: 'Aeroparque J. Newbery',
    kicker: 'Gran escala',
    description:
      'Remodelación integral de baños preembarque y reparación de cubiertas.',
    images: [an1, an2, an3, an4],
  },
  {
    id: 'aeropuerto-ezeiza',
    year: '2020',
    title: 'Aeropuerto Ministro Pistarini',
    kicker: 'Gran escala',
    description: 'Instalaciones.',
    images: [ez1, ez2, ez3, ez4],
  },
  {
    id: 'gimnasios-fitter',
    year: '2018',
    title: 'Gimnasios Fitter · Megatlon',
    kicker: 'Comercial',
    description: 'Instalaciones y estética.',
    images: [gf1, gf2, gf3, gf4],
  },
];
const fulls = await Promise.all(sections.map((s) => Promise.all(s.images.map(async (im) => (await getImage({ src: im, width: 2000, format: 'webp' })).src))));
---

<Layout
  title="Gran escala y patrimonio"
  description="Gran escala y patrimonio: obras de Daniela Estevez Vredjian."
>
  <!-- ===========================================
       HERO
  =========================================== -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-12 flex items-start justify-between text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark font-light anim-rise">
      <span>Trayectoria</span>
      <span class="text-right">Buenos Aires</span>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 md:pt-16 pb-10 md:pb-14">
      <header>
        <h1 class="anim-rise" style="--rise-delay: 120ms">
          <span class="block text-5xl sm:text-6xl md:text-8xl font-thin leading-[0.95] tracking-[-0.02em] text-dun-cream">
            Gran escala
          </span>
          <span class="block text-5xl sm:text-6xl md:text-8xl font-light leading-[0.95] tracking-[-0.02em] text-dun-cream-dark pl-[10%] md:pl-[18%]">
            y patrimonio.
          </span>
        </h1>
      </header>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-10"><div class="dun-rule"></div></div>
  </section>

  <!-- ===========================================
       SECTIONS — galleries
  =========================================== -->
  {sections.map((s, i) => (
    <section id={s.id} class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-28 scroll-mt-20" data-reveal>
      <div class="grid grid-cols-12 gap-y-8 md:gap-x-10 mb-10 md:mb-14">
        <!-- Sidebar: numeral + kicker + title -->
        <div class="col-span-12 md:col-span-4">
          <span class="dun-numeral text-5xl md:text-7xl block leading-[0.8]">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="mt-4 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark">{s.kicker} · {s.year}</p>
          <h2 class="mt-3 text-3xl md:text-5xl font-light tracking-tight text-dun-cream leading-[1]">
            {s.title}
          </h2>
          {s.description && (
            <p class="mt-5 text-base text-dun-cream-dark font-light leading-relaxed max-w-md">
              {s.description}
            </p>
          )}
        </div>

        <!-- Right gutter: image count + back-to-index -->
        <div class="col-span-12 md:col-span-8 md:flex md:flex-col md:items-end md:justify-end">
          <div class="text-[11px] uppercase tracking-[0.3em] text-dun-muted">
            {String(s.images.length).padStart(2, '0')} imágenes
          </div>
        </div>
      </div>

      <!-- Gallery grid — varying tile sizes for editorial rhythm -->
      <div class="grid grid-cols-6 gap-3 md:gap-5">
        {s.images.map((img, j) => {
          const big = j === 0;
          const span = big ? 'col-span-6 md:col-span-4 aspect-[16/10]' : 'col-span-3 md:col-span-2 aspect-[4/3]';
          return (
            <button type="button" data-lightbox={s.id} data-full={fulls[i][j]} data-alt={`Obra ${s.title}, foto ${j + 1}`} aria-label={`Ampliar foto ${j + 1} de ${s.title}`} class={`img-frame relative block cursor-zoom-in ${span}`}>
              <Image
                src={img}
                alt={`Obra ${s.title}, foto ${j + 1}`}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1100ms] hover:scale-[1.03]"
              />
              <span class="absolute left-3 bottom-2 text-[11px] uppercase tracking-[0.25em] text-dun-cream z-10">
                {String(j + 1).padStart(2, '0')}
              </span>
            </button>
          );
        })}
      </div>

      <div class="mt-10 md:mt-14">
        <div class="dun-rule"></div>
      </div>
    </section>
  ))}
  <Lightbox />
</Layout>
