---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Contacto | DUN · estudio de arquitectura"
  description="Contacto de DUN · Estudio de arquitectura. WhatsApp +54 9 11 6237-4256 o email."
>
  <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-20 pb-20 md:pb-32">
    <a
      href={`${base}/`}
      class="inline-flex items-center gap-2 min-h-11 text-[13px] text-dun-cream-dark hover:text-dun-cream transition mb-10 md:mb-16 anim-rise"
    >
      <span class="block w-6 h-px bg-current"></span> Volver al inicio
    </a>

    <header class="mb-14 md:mb-20">
      <p class="text-[13px] text-dun-muted mb-4">Contacto</p>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-thin tracking-tight text-dun-cream leading-[1.05] max-w-4xl">
        Conversemos.
      </h1>
    </header>

    <div class="max-w-xl space-y-8 pt-8 border-t border-dun-cream/15">
      <a
        href="https://wa.me/5491162374256?text=Hola%20Daniela,%20me%20gustar%C3%ADa%20consultarte%20por%20un%20proyecto"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-between w-full px-6 py-4 bg-dun-cream hover:bg-dun-cream-dark text-dun-dark text-[13px] font-medium transition-colors duration-300"
      >
        <span>Escribir por WhatsApp</span>
        <span class="text-base" aria-hidden="true">→</span>
      </a>

      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSfbb1MBpGSuPBpznQtWC6G3lgJR5Vr-CYQGcGh3jn5ns54i0A/viewform"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-between w-full px-6 py-4 border border-dun-cream/40 hover:border-dun-cream hover:bg-dun-cream hover:text-dun-dark text-dun-cream text-[13px] transition-colors duration-300"
      >
        <span>Completar formulario “Mi reforma 2026”</span>
        <span class="text-base" aria-hidden="true">→</span>
      </a>

      <dl class="space-y-1 text-sm font-light">
        <div class="flex items-center gap-4">
          <dt class="text-[13px] text-dun-muted w-24 shrink-0">WhatsApp</dt>
          <dd><a href="https://wa.me/5491162374256" target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 whitespace-nowrap text-dun-cream hover:underline">+54 9 11 6237-4256</a></dd>
        </div>
        <div class="flex items-center gap-4">
          <dt class="text-[13px] text-dun-muted w-24 shrink-0">Email</dt>
          <dd><a href="mailto:hola.dun.arquitectura@gmail.com" class="inline-flex items-center min-h-11 text-dun-cream hover:underline break-all">hola.dun.arquitectura@gmail.com</a></dd>
        </div>
        <div class="flex items-center gap-4">
          <dt class="text-[13px] text-dun-muted w-24 shrink-0">Instagram</dt>
          <dd><a href="https://www.instagram.com/dun.arquitectura/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 text-dun-cream hover:underline">@dun.arquitectura</a></dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>
