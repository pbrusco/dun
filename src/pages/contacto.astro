---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Contacto | DUN · estudio de arquitectura"
  description="Contacto de DUN · Estudio de arquitectura. WhatsApp +54 9 11 6237-4256 o email."
>
  <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-20 pb-20 md:pb-32">
    <a
      href={`${base}/`}
      class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.3em] text-dun-muted hover:text-dun-cream-dark transition mb-10 md:mb-16 anim-rise"
    >
      <span class="block w-6 h-px bg-current"></span> Volver al inicio
    </a>

    <header class="mb-14 md:mb-20">
      <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted mb-4">Contacto</p>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-thin tracking-tight text-dun-cream leading-[1.05] max-w-4xl">
        Conversemos.
      </h1>
    </header>

    <div class="max-w-xl space-y-8 pt-8 border-t border-dun-cream/15">
      <a
        href="https://wa.me/5491162374256?text=Hola%20Daniela,%20me%20gustar%C3%ADa%20consultarte%20por%20un%20proyecto"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-between w-full px-6 py-4 bg-dun-cream hover:bg-dun-cream-dark text-dun-dark text-[11px] uppercase tracking-[0.25em] font-medium transition-all duration-300"
      >
        <span>Escribir por WhatsApp</span>
        <span class="text-base">→</span>
      </a>

      <dl class="space-y-4 text-sm font-light">
        <div class="flex items-center gap-4">
          <dt class="text-[10px] uppercase tracking-[0.25em] text-dun-muted w-24 shrink-0">WhatsApp</dt>
          <dd><a href="https://wa.me/5491162374256" target="_blank" rel="noopener noreferrer" class="text-dun-cream hover:underline">+54 9 11 6237-4256</a></dd>
        </div>
        <div class="flex items-center gap-4">
          <dt class="text-[10px] uppercase tracking-[0.25em] text-dun-muted w-24 shrink-0">Email</dt>
          <dd><a href="mailto:hola.dun.arquitectura@gmail.com" class="text-dun-cream hover:underline break-all">hola.dun.arquitectura@gmail.com</a></dd>
        </div>
        <div class="flex items-center gap-4">
          <dt class="text-[10px] uppercase tracking-[0.25em] text-dun-muted w-24 shrink-0">Instagram</dt>
          <dd><a href="https://www.instagram.com/dun.arquitectura/" target="_blank" rel="noopener noreferrer" class="text-dun-cream hover:underline">@dun.arquitectura</a></dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>
