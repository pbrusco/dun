---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, location, year, category, plan, before, after, gallery } = entry.data;

const hasBeforeAfter = before && after;

// Versión grande de cada foto para el visor
const full = await Promise.all(
  (gallery ?? []).map(async (img) => (await getImage({ src: img, width: 2000, format: 'webp' })).src)
);
const planFull = plan ? (await getImage({ src: plan, width: 2000, format: 'webp' })).src : undefined;

// Mismo orden que la home, para que "siguiente" coincida con lo que se ve al navegar.
const all = await getCollection('projects');
const projectOrder = (slug: string) => {
  const m: Record<string, number> = {
    'depto-saavedra-2025': 1,
    'cocina-devoto-2026': 2,
    'villa-ortuzar-2026': 3,
    'bano-caballito-2026': 4,
    'bano-barracas-2026': 5,
    'cocina-palermo-2025': 6,
    'cocina-villa-urquiza-2025': 7,
    'ph-saavedra-2025': 8,
    'depto-corrientes-2025': 9,
    'bano-ph-saavedra-2025': 10,
    'bano-palermo-2025': 11,
    'bano-olivos-2025': 12,
    'placard-villa-urquiza-2025': 13,
    'placard-villa-pueyrredon-2025': 14,
    'local-palermo-2021': 15,
  };
  return m[slug] ?? 99;
};
const ordered = [...all].sort((a, b) => projectOrder(a.slug) - projectOrder(b.slug));
const idx = ordered.findIndex((p) => p.slug === entry.slug);
const next = ordered[(idx + 1) % ordered.length];
---

<Layout title={title}>
  <article>
    <!-- Encabezado -->
    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-8 md:pt-14 pb-10 md:pb-16">
      <a
        href={`${base}/#proyectos`}
        class="inline-flex items-center gap-2 min-h-11 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark hover:text-dun-cream transition mb-6 md:mb-10 anim-rise"
      >
        <span class="block w-6 h-px bg-current"></span> Volver a las obras
      </a>

      <h1 class="anim-rise text-[11vw] sm:text-[10vw] md:text-[6vw] xl:text-[5.5rem] font-thin leading-[1] tracking-[-0.02em] text-dun-cream break-words" style="--rise-delay: 120ms">
        {title}
      </h1>

      <p class="mt-5 md:mt-6 text-[11px] md:text-xs uppercase tracking-[0.25em] text-dun-cream-dark anim-rise" style="--rise-delay: 240ms">
        {[category, location, year].filter(Boolean).join(' · ')}
      </p>
    </section>

    <!-- Plano / proyecto -->
    {plan && (
      <section class="max-w-7xl mx-auto px-6 md:px-10 pb-10 md:pb-16" data-reveal>
        <button type="button" data-lightbox="plan" data-full={planFull} data-alt={`Proyecto — ${title}`} class="img-frame block w-full bg-dun-darker cursor-zoom-in">
          <Image src={plan} alt={`Proyecto — ${title}`} class="w-full block" />
        </button>
      </section>
    )}

    <!-- Antes / después -->
    {hasBeforeAfter && (
      <section class="max-w-7xl mx-auto px-6 md:px-10 pb-10 md:pb-16" data-reveal>
        <BeforeAfter before={before!} after={after!} />
        <p class="mt-3 text-[11px] uppercase tracking-[0.25em] text-dun-muted text-center">Deslizá para comparar</p>
      </section>
    )}

    <!-- Fotos -->
    {gallery && gallery.length > 0 && (
      <section class="max-w-7xl mx-auto px-6 md:px-10 pb-10 md:pb-16" data-reveal>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-5">
          {gallery.map((img, i) => (
            <button
              type="button"
              data-lightbox="galeria"
              data-full={full[i]}
              data-alt={`${title} — foto ${i + 1}`}
              aria-label={`Ampliar foto ${i + 1} de ${gallery.length}`}
              class={`img-frame relative block cursor-zoom-in ${i % 3 === 0 ? 'sm:col-span-2 aspect-[4/3] md:aspect-[16/9]' : 'aspect-[4/3]'}`}
            >
              <Image
                src={img}
                alt={`${title} — foto ${i + 1}`}
                class="absolute inset-0 w-full h-full object-cover"
              />
              <span class="absolute left-3 bottom-2 text-[11px] uppercase tracking-[0.25em] text-dun-cream/90 z-10">
                {String(i + 1).padStart(2, '0')} / {String(gallery.length).padStart(2, '0')}
              </span>
            </button>
          ))}
        </div>
      </section>
    )}

    <!-- Siguiente obra -->
    {next && next.slug !== entry.slug && (
      <section class="border-t border-dun-cream/10 mt-10">
        <a
          href={`${base}/projects/${next.slug}`}
          class="group block py-10 md:py-20 hover:bg-dun-darker/30 transition-colors duration-500"
        >
          <div class="max-w-7xl mx-auto px-6 md:px-10 grid grid-cols-12 gap-4 md:gap-6 items-end">
            <div class="col-span-12 md:col-span-3">
              <p class="text-[11px] uppercase tracking-[0.3em] text-dun-muted">Siguiente obra</p>
            </div>
            <div class="col-span-9 md:col-span-6">
              <h2 class="text-2xl md:text-5xl font-light tracking-tight text-dun-cream group-hover:text-white transition leading-[0.95]">
                {next.data.title}
              </h2>
              {(next.data.location || next.data.year) && (
                <p class="mt-3 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark">
                  {[next.data.location, next.data.year].filter(Boolean).join(' · ')}
                </p>
              )}
            </div>
            <div class="col-span-3 md:col-span-3 text-right">
              <span class="inline-flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-dun-cream-dark group-hover:text-dun-cream transition">
                <span class="hidden sm:block w-8 h-px bg-current group-hover:w-16 transition-all duration-500"></span>
                Ver
              </span>
            </div>
          </div>
        </a>
      </section>
    )}
  </article>
  <Lightbox />
</Layout>
