---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'default' | 'featured';
  index?: number;
}

const { project, variant = 'default', index } = Astro.props;
const { title, description, cover, category, location, year } = project.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const numeral = index !== undefined ? String(index).padStart(2, '0') : undefined;
const aspect = variant === 'featured' ? 'aspect-[4/3] md:aspect-[16/9]' : 'aspect-square';

const getFilterGroup = (slug: string) => {
  if (slug.startsWith('cocina-') || slug === 'depto-saavedra-2025') return 'cocinas';
  if (slug.startsWith('bano-')) return 'banos';
  if (slug.startsWith('placard-')) return 'mobiliario';
  if (slug === 'local-palermo-2021') return 'comercial';
  return 'reformas';
};
const filterGroup = getFilterGroup(project.slug);

const specialBadges: Record<string, string> = {
  'local-palermo-2021': 'Comercial',
};
const badgeLabel = project.slug.startsWith('bano-')
  ? 'Baño'
  : project.slug.startsWith('placard-')
    ? 'Mobiliario a medida'
    : (specialBadges[project.slug] ?? category);
const hasSpecialBadge = project.slug.startsWith('bano-') || project.slug.startsWith('placard-') || project.slug in specialBadges;
---

<a
  href={`${base}/projects/${project.slug}`}
  data-project-card
  data-group={filterGroup}
  class:list={[
    'group block relative transition-all duration-500',
    variant === 'featured' ? '' : '',
  ]}
>
  <!-- Numeral floating top-left -->
  {numeral && (
    <span class="absolute -top-1 -left-1 md:-top-2 md:-left-3 dun-numeral text-3xl md:text-4xl pointer-events-none z-10">
      {numeral}
    </span>
  )}

  <!-- Image frame -->
  <div class={`img-frame ${aspect} bg-dun-darker`}>
    <Image
      src={cover}
      alt={`Portada de ${title}`}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.05] transition-transform duration-[700ms] ease-out"
    />

    <!-- Year as typographic watermark in corner -->
    {year && (
      <span
        aria-hidden="true"
        class="absolute right-2 md:right-4 bottom-1 md:bottom-2 text-[clamp(3.5rem,7vw,7rem)] font-thin leading-none text-dun-cream/95 mix-blend-overlay pointer-events-none select-none"
        style="text-shadow: 0 2px 30px rgba(0,0,0,0.3)"
      >
        {year}
      </span>
    )}

    <!-- Category / Special chip -->
    <span class={`absolute top-3 md:top-4 right-3 md:right-4 px-2.5 py-1 text-[10px] font-light tracking-[0.25em] uppercase border backdrop-blur-sm ${
      hasSpecialBadge
        ? 'border-dun-cream-dark/60 text-dun-cream-dark bg-dun-darker/60'
        : 'border-dun-cream/40 text-dun-cream bg-dun-darker/30'
    }`}>
      {badgeLabel}
    </span>

    <!-- Hover overlay indicator -->
    <div class="absolute left-3 md:left-4 bottom-3 md:bottom-4 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-1 group-hover:translate-y-0 z-10 hidden sm:flex items-center gap-2 text-[9px] uppercase tracking-[0.25em] text-dun-cream bg-dun-dark/85 backdrop-blur-md px-3 py-1.5 border border-dun-cream/30">
      <span>Ver obra</span>
      <span class="text-xs">→</span>
    </div>
  </div>

  <!-- Caption -->
  <div class="pt-5 md:pt-6 flex items-start justify-between gap-6">
    <div class="flex-1 min-w-0">
      <h3 class={`font-light tracking-wide text-dun-cream group-hover:text-white transition ${variant === 'featured' ? 'text-2xl md:text-4xl' : 'text-lg md:text-xl'}`}>
        {title}
      </h3>
      {description && (
        <p class="mt-2 text-xs md:text-sm font-light text-dun-cream-dark line-clamp-2 leading-relaxed">
          {description}
        </p>
      )}
    </div>
    <div class="text-right shrink-0">
      {location && (
        <p class="text-[10px] uppercase tracking-[0.25em] text-dun-muted font-light leading-relaxed">
          {location}
        </p>
      )}
      <span class="mt-2.5 inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.2em] text-dun-cream-dark group-hover:text-dun-cream transition-all">
        <span>Ver proyecto</span>
        <span class="text-xs">→</span>
      </span>
    </div>
  </div>
</a>
