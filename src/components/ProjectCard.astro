---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'default' | 'featured';
  index?: number;
}

const { project, variant = 'default', index } = Astro.props;
const { title, description, cover, category, location, year } = project.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const numeral = index !== undefined ? String(index).padStart(2, '0') : undefined;
const aspect = variant === 'featured' ? 'aspect-[16/9] md:aspect-[21/9]' : 'aspect-[4/5]';
---

<a
  href={`${base}/projects/${project.slug}`}
  class:list={[
    'group block relative',
    variant === 'featured' ? '' : '',
  ]}
>
  <!-- Numeral floating top-left -->
  {numeral && (
    <span class="absolute -top-1 -left-1 md:-top-2 md:-left-3 dun-numeral text-3xl md:text-4xl pointer-events-none z-10">
      {numeral}
    </span>
  )}

  <!-- Image frame -->
  <div class={`img-frame ${aspect} bg-dun-darker`}>
    <Image
      src={cover}
      alt={`Portada de ${title}`}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-[1100ms] ease-[cubic-bezier(0.2,0.7,0.2,1)]"
    />

    <!-- Year as oversized typographic anchor in image corner -->
    {year && (
      <span
        aria-hidden="true"
        class="absolute right-2 md:right-4 bottom-1 md:bottom-2 text-[clamp(3.5rem,7vw,7rem)] font-thin leading-none text-dun-cream/95 mix-blend-overlay pointer-events-none select-none"
        style="text-shadow: 0 2px 30px rgba(0,0,0,0.3)"
      >
        {year}
      </span>
    )}

    <!-- Category chip -->
    <span class="absolute top-3 md:top-4 right-3 md:right-4 px-2.5 py-1 text-[10px] font-light tracking-[0.25em] uppercase border border-dun-cream/40 text-dun-cream bg-dun-darker/30 backdrop-blur-sm">
      {category}
    </span>
  </div>

  <!-- Caption -->
  <div class="pt-5 md:pt-6 flex items-start justify-between gap-6">
    <div class="flex-1 min-w-0">
      <h3 class={`font-light tracking-wide text-dun-cream group-hover:text-white transition ${variant === 'featured' ? 'text-2xl md:text-4xl' : 'text-lg md:text-xl'}`}>
        {title}
      </h3>
      {(location || description) && (
        <p class="mt-2 text-sm font-light text-dun-cream-dark/80 line-clamp-2 leading-relaxed">
          {description ?? location}
        </p>
      )}
    </div>
    <div class="text-right shrink-0">
      <p class="text-[10px] uppercase tracking-[0.3em] text-dun-muted leading-relaxed">
        {location && <span class="block">{location}</span>}
      </p>
      <span class="mt-2 inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.25em] text-dun-cream-dark/70 group-hover:text-dun-cream transition">
        Ver
        <span class="block w-5 h-px bg-current group-hover:w-9 transition-all duration-500"></span>
      </span>
    </div>
  </div>
</a>
