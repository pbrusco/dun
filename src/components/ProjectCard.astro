---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'default' | 'featured';
  index?: number;
}

const { project, variant = 'default' } = Astro.props;
const { title, cover, location, year } = project.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const aspect = variant === 'featured' ? 'aspect-[4/3] md:aspect-[16/9]' : 'aspect-square';

const getFilterGroup = (slug: string) => {
  if (slug.startsWith('cocina-') || slug === 'depto-saavedra-2025') return 'cocinas';
  if (slug.startsWith('bano-')) return 'banos';
  if (slug.startsWith('placard-')) return 'mobiliario';
  if (slug === 'local-palermo-2021') return 'comercial';
  return 'reformas';
};
const filterGroup = getFilterGroup(project.slug);

---

<a
  href={`${base}/projects/${project.slug}`}
  data-project-card
  data-group={filterGroup}
  class="group block relative"
>
  <div class={`img-frame ${aspect} bg-dun-darker`}>
    <Image
      src={cover}
      alt={`Portada de ${title}`}
      class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-[700ms] ease-out"
    />
  </div>

  <div class="pt-4 md:pt-5">
    <h3 class={`font-light tracking-wide text-dun-cream group-hover:text-white transition ${variant === 'featured' ? 'text-2xl md:text-4xl' : 'text-lg md:text-xl'}`}>
      {title}
    </h3>
    <p class="mt-1.5 text-xs md:text-sm font-light text-dun-muted tracking-wide">
      {[location, year].filter(Boolean).join(' · ')}
    </p>
  </div>
</a>
