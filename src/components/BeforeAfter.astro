---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel?: string;
  afterLabel?: string;
}

const { before, after, beforeLabel = 'Antes', afterLabel = 'Después' } = Astro.props;

const portrait = after.height > after.width;
const aspect = portrait ? 'aspect-[3/4] max-w-md mx-auto' : 'aspect-[4/3] md:aspect-video';
---

<div
  class={`relative w-full ${aspect} overflow-hidden cursor-ew-resize select-none rounded-xl`}
  style="touch-action: pan-y"
  role="slider"
  tabindex="0"
  aria-label={`Comparar ${beforeLabel.toLowerCase()} y ${afterLabel.toLowerCase()}`}
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="50"
  data-slider
>
  <!-- After (base layer) -->
  <Image draggable="false" src={after} alt={afterLabel} class="absolute inset-0 w-full h-full object-cover" />

  <!-- Before (clipped on top) -->
  <div class="absolute inset-0 overflow-hidden" data-before style="clip-path: inset(0 50% 0 0)">
    <Image draggable="false" src={before} alt={beforeLabel} class="w-full h-full object-cover" />
  </div>

  <!-- Divider line + handle -->
  <div
    class="absolute inset-y-0 flex flex-col items-center justify-center pointer-events-none"
    data-line
    style="left: 50%; transform: translateX(-50%)"
  >
    <div class="w-0.5 h-full bg-white shadow-lg"></div>
    <div
      aria-hidden="true"
      class="absolute top-1/2 -translate-y-1/2 w-10 h-10 bg-white rounded-full shadow-xl flex items-center justify-center text-neutral-700 font-semibold text-sm"
    >
      ↔
    </div>
  </div>

  <!-- Labels -->
  <span class="absolute bottom-3 left-4 text-xs font-semibold text-white bg-black/40 px-2 py-1 rounded">
    {beforeLabel}
  </span>
  <span class="absolute bottom-3 right-4 text-xs font-semibold text-white bg-black/40 px-2 py-1 rounded">
    {afterLabel}
  </span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((container) => {
    const beforeDiv = container.querySelector<HTMLElement>('[data-before]')!;
    const lineDiv = container.querySelector<HTMLElement>('[data-line]')!;
    let pct = 50;

    const set = (p: number) => {
      pct = Math.min(Math.max(p, 0), 100);
      beforeDiv.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
      lineDiv.style.left = `${pct}%`;
      container.setAttribute('aria-valuenow', String(Math.round(pct)));
    };
    const fromX = (clientX: number) => {
      const rect = container.getBoundingClientRect();
      set(((clientX - rect.left) / rect.width) * 100);
    };

    // Sin esto el navegador arrastra la foto y cancela el gesto del slider.
    container.addEventListener('dragstart', (e) => e.preventDefault());
    container.addEventListener('pointerdown', (e) => {
      container.setPointerCapture(e.pointerId);
      fromX(e.clientX);
    });
    container.addEventListener('pointermove', (e) => {
      if (container.hasPointerCapture(e.pointerId)) fromX(e.clientX);
    });

    container.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 20 : 5;
      const next: Record<string, number> = {
        ArrowLeft: pct - step,
        ArrowDown: pct - step,
        ArrowRight: pct + step,
        ArrowUp: pct + step,
        Home: 0,
        End: 100,
      };
      if (e.key in next) {
        e.preventDefault();
        set(next[e.key]);
      }
    });
  });
</script>
