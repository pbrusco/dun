---
import Logo from '../components/Logo.astro';
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'DUN · Estudio de arquitectura en Buenos Aires.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/' || path === base || path === `${base}/`;
const isActive = (target: string) => {
  if (target === '/') return isHome;
  return path === `${base}${target}` || path.startsWith(`${base}${target}/`);
};

const fullTitle = title.includes('DUN') ? title : `${title} | DUN · estudio de arquitectura`;
const canonicalUrl = `https://dunarquitectura.com.ar${path === '/' ? '' : path}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#033b38" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://dunarquitectura.com.ar/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://dunarquitectura.com.ar/og-image.jpg" />

    <!-- Schema.org JSON-LD LocalBusiness / Architect -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Architect",
        "name": "DUN · Estudio de Arquitectura",
        "legalName": "Daniela Estevez Vredjian",
        "founder": {
          "@type": "Person",
          "name": "Daniela Estevez Vredjian",
          "jobTitle": "Arquitecta"
        },
        "url": "https://dunarquitectura.com.ar",
        "logo": "https://dunarquitectura.com.ar/logo-header.webp",
        "image": "https://dunarquitectura.com.ar/og-image.jpg",
        "telephone": "+5491162374256",
        "email": "hola.dun.arquitectura@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Ciudad Autónoma de Buenos Aires",
          "addressRegion": "CABA",
          "addressCountry": "AR"
        },
        "sameAs": [
          "https://www.instagram.com/dun.arquitectura/"
        ]
      }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@100;200;300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dun-dark text-dun-cream antialiased font-sans relative">

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-dun-cream focus:text-dun-dark focus:px-4 focus:py-3 text-[13px]">Saltar al contenido</a>

    <!-- Atmospheric grain overlay (fixed, pointer-events-none) -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Nav -->
    <nav aria-label="Principal" class="bg-dun-dark/90 backdrop-blur-sm border-b border-dun-cream/5 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 md:px-8 py-2 md:py-3 flex items-center justify-between gap-3">
        <a href={`${base}/`} class="flex items-center min-h-11 hover:opacity-90 transition shrink-0" aria-label="DUN, ir al inicio">
          <Logo class="h-7 md:h-11 w-auto" />
        </a>

        <!-- Escritorio -->
        <div class="hidden md:flex items-center gap-6 text-sm font-light tracking-wider text-dun-cream-dark">
          <a
            href={isHome ? '#proyectos' : `${base}/#proyectos`}
            aria-current={isHome ? 'page' : undefined}
            class:list={['nav-link inline-flex items-center min-h-11 text-[13px]', isHome && 'is-active']}
          >Para particulares</a>
          <a
            href={`${base}/obras-anteriores`}
            aria-current={isActive('/obras-anteriores') ? 'page' : undefined}
            class:list={['nav-link inline-flex items-center min-h-11 text-[13px]', isActive('/obras-anteriores') && 'is-active']}
          >Gran escala y patrimonio</a>
          <a
            href={`${base}/sobre-mi`}
            aria-current={isActive('/sobre-mi') ? 'page' : undefined}
            class:list={['nav-link inline-flex items-center min-h-11 text-[13px]', isActive('/sobre-mi') && 'is-active']}
          >Sobre mí</a>
          <a
            href={`${base}/contacto`}
            aria-current={isActive('/contacto') ? 'page' : undefined}
            class:list={[
              'cta-link inline-flex items-center min-h-11 border border-dun-cream text-dun-cream px-5 text-[13px] hover:bg-dun-cream hover:text-dun-dark transition-colors duration-300 font-normal whitespace-nowrap',
              isActive('/contacto') && 'bg-dun-cream text-dun-dark',
            ]}
          >Contacto</a>
        </div>

        <!-- Celular -->
        <div class="flex md:hidden items-center gap-0.5">
          <a
            href={`${base}/sobre-mi`}
            aria-current={isActive('/sobre-mi') ? 'page' : undefined}
            class:list={['nav-link inline-flex items-center min-h-11 px-1.5 text-[13px] whitespace-nowrap', isActive('/sobre-mi') && 'is-active']}
          >Sobre mí</a>
          <a
            href={`${base}/contacto`}
            aria-current={isActive('/contacto') ? 'page' : undefined}
            class:list={[
              'cta-link inline-flex items-center min-h-11 border border-dun-cream text-dun-cream px-2.5 text-[13px] font-normal whitespace-nowrap transition-colors duration-300 hover:bg-dun-cream hover:text-dun-dark',
              isActive('/contacto') && 'bg-dun-cream text-dun-dark',
            ]}
          >Contacto</a>
          <button
            type="button"
            id="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-panel"
            aria-label="Abrir menú"
            class="w-11 h-11 flex items-center justify-center text-dun-cream cursor-pointer"
          >
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path class="nav-ico-open" d="M3 6h14M3 14h14" />
              <path class="nav-ico-close hidden" d="M4 4l12 12M16 4L4 16" />
            </svg>
          </button>
        </div>
      </div>

      <div id="nav-panel" hidden class="md:hidden border-t border-dun-cream/10 bg-dun-dark">
        <ul class="px-4 py-2">
          <li><a href={isHome ? '#proyectos' : `${base}/#proyectos`} class="flex items-center min-h-12 text-[13px] text-dun-cream">Para particulares</a></li>
          <li><a href={`${base}/obras-anteriores`} class="flex items-center min-h-12 text-[13px] text-dun-cream border-t border-dun-cream/10">Gran escala y patrimonio</a></li>
          <li><a href={`${base}/sobre-mi`} class="flex items-center min-h-12 text-[13px] text-dun-cream border-t border-dun-cream/10">Sobre mí</a></li>
        </ul>
      </div>
    </nav>

    <main id="main" tabindex="-1" class="min-h-screen relative focus:outline-none">
      <slot />
    </main>

    <footer class="bg-dun-darker text-dun-cream border-t border-dun-cream/10 mt-24 md:mt-32 relative overflow-hidden">
      <!-- Decorative oversized wordmark -->
      <div aria-hidden="true" class="absolute inset-x-0 -bottom-6 md:-bottom-16 text-center pointer-events-none select-none">
        <span class="font-thin tracking-[0.25em] text-[18vw] md:text-[14vw] leading-none text-dun-cream/[0.04]">
          DUN
        </span>
      </div>

      <div class="relative max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-20 grid gap-12 md:grid-cols-12">
        <div class="md:col-span-5">
          <a href={`${base}/`} class="inline-flex mb-6" aria-label="DUN, ir al inicio"><Logo class="h-12 md:h-16 w-auto" /></a>
          <p class="text-[13px] text-dun-cream-dark font-light leading-relaxed max-w-xs">
            Estudio de arquitectura<br/>
            Reformas integrales · Restauración de patrimonio
          </p>
        </div>

        <div class="md:col-span-3">
          <p class="text-[13px] text-dun-muted mb-4 font-light">Navegación</p>
          <ul class="space-y-0 text-sm font-light">
            <li><a href={`${base}/#proyectos`} class="footer-link">Para particulares</a></li>
            <li><a href={`${base}/obras-anteriores`} class="footer-link">Gran escala y patrimonio</a></li>
            <li><a href={`${base}/sobre-mi`} class="footer-link">Sobre mí</a></li>
            <li><a href={`${base}/contacto`} class="footer-link">Contacto</a></li>
          </ul>
        </div>

        <div class="md:col-span-4">
          <p class="text-[13px] text-dun-muted mb-4 font-light">Estudio & Contacto</p>
          <div class="text-sm font-light leading-relaxed space-y-1">
            <p>
              Daniela Estevez Vredjian<br/>
              <span class="text-dun-cream-dark">Buenos Aires · Argentina</span>
            </p>
            <ul class="space-y-0 text-sm text-dun-cream pt-1">
              <li>
                <a
                  href="https://wa.me/5491162374256?text=Hola%20Daniela,%20me%20gustar%C3%ADa%20consultarte%20por%20un%20proyecto"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline inline-flex items-center gap-3 min-h-11"
                >
                  <span class="text-[13px] text-dun-muted font-light w-24 shrink-0">WhatsApp</span>
                  <span class="whitespace-nowrap">+54 9 11 6237-4256</span>
                </a>
              </li>
              <li>
                <a
                  href="mailto:hola.dun.arquitectura@gmail.com"
                  class="hover:underline inline-flex items-center gap-3 min-h-11"
                >
                  <span class="text-[13px] text-dun-muted font-light w-24 shrink-0">Email</span>
                  <span>hola.dun.arquitectura@gmail.com</span>
                </a>
              </li>
              <li>
                <a
                  href="https://www.instagram.com/dun.arquitectura/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline inline-flex items-center gap-3 min-h-11"
                >
                  <span class="text-[13px] text-dun-muted font-light w-24 shrink-0">Instagram</span>
                  <span>@dun.arquitectura</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="relative border-t border-dun-cream/10">
        <div class="max-w-7xl mx-auto px-6 md:px-10 py-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-2 text-[13px] text-dun-muted font-light">
          <span>&copy; {new Date().getFullYear()} DUN · hogar en armenio</span>
          <span class="normal-case tracking-normal text-sm font-light text-dun-cream-dark">
            encontramos la forma de hacer <span class="font-normal text-dun-cream">hogar</span>
          </span>
        </div>
      </div>
    </footer>

    <!-- Floating WhatsApp quick contact pill -->
    {!isActive('/contacto') && (
    <aside id="wa-fab" inert={isHome} aria-label="Contacto rápido" class:list={['fixed right-4 md:right-5 z-40 transition-[opacity,transform] duration-500', isHome && 'opacity-0 translate-y-3 pointer-events-none']} style="bottom: max(1rem, env(safe-area-inset-bottom))">
      <a
        href="https://wa.me/5491162374256?text=Hola%20Daniela,%20me%20gustar%C3%ADa%20consultarte%20por%20un%20proyecto"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 bg-dun-darker/95 hover:bg-dun-cream hover:text-dun-dark text-dun-cream border border-dun-cream/30 hover:border-dun-cream w-12 h-12 md:w-auto md:min-h-11 justify-center md:px-4 rounded-full backdrop-blur-md shadow-xl transition-colors duration-300 group"
        title="Enviar mensaje por WhatsApp (+54 9 11 6237-4256)"
        aria-label="Escribir por WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-4 md:h-4 fill-current text-dun-cream-dark group-hover:text-dun-dark transition-colors shrink-0" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span class="hidden md:inline text-[13px] font-light">WhatsApp</span>
      </a>
    </aside>
    )}

    <script>
      // Scroll-reveal: any [data-reveal] gets a fade-up when it enters the viewport.
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-revealed');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Menú del celular
      const navBtn = document.getElementById('nav-toggle');
      const navPanel = document.getElementById('nav-panel');
      const setNav = (open: boolean) => {
        if (!navBtn || !navPanel) return;
        navPanel.hidden = !open;
        navBtn.setAttribute('aria-expanded', String(open));
        navBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        navBtn.querySelector('.nav-ico-open')?.classList.toggle('hidden', open);
        navBtn.querySelector('.nav-ico-close')?.classList.toggle('hidden', !open);
      };
      navBtn?.addEventListener('click', () => setNav(navPanel?.hidden ?? false));
      navPanel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setNav(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setNav(false); });

      // En la home el botón de WhatsApp aparece recién al pasar la portada.
      const fab = document.getElementById('wa-fab');
      const hero = document.getElementById('portada');
      if (fab && hero) {
        const show = (on: boolean) => {
          fab.classList.toggle('opacity-0', !on);
          fab.classList.toggle('translate-y-3', !on);
          fab.classList.toggle('pointer-events-none', !on);
          fab.toggleAttribute('inert', !on);
        };
        new IntersectionObserver(([e]) => show(!e.isIntersecting), { threshold: 0.15 }).observe(hero);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --dun-dark: #033b38;
    --dun-darker: #022b29;
    --dun-cream: #eceadb;
    --dun-cream-dark: #cca067;
    --dun-muted: #bd9f84;
    color-scheme: dark;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: clip;
  }

  body {
    font-feature-settings: 'kern', 'liga', 'calt', 'ss01';
    overflow-x: clip;
    width: 100%;
  }

  /* ====== Grain overlay — adds atmosphere to the dark teal base ====== */
  .grain-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.06;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.93  0 0 0 0 0.91  0 0 0 0 0.86  0 0 0 1 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    background-size: 200px 200px;
  }

  main, footer, nav {
    position: relative;
    z-index: 2;
  }

  /* ====== Typography ====== */
  h1, h2, h3, h4 {
    font-family: 'Lexend', system-ui, sans-serif;
    letter-spacing: 0.04em;
    font-feature-settings: 'kern', 'ss01';
  }

  h1 {
    font-weight: 200;
  }


  /* Foco visible para teclado */
  :focus-visible {
    outline: 2px solid var(--dun-cream-dark);
    outline-offset: 3px;
  }

  /* Selection */
  ::selection {
    background: var(--dun-cream-dark);
    color: var(--dun-darker);
  }

  /* ====== Nav links — animated underline ====== */
  .nav-link {
    position: relative;
    color: rgba(236, 234, 219, 0.7);
    transition: color 250ms ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 1px;
    background: var(--dun-cream);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 400ms cubic-bezier(0.7, 0, 0.3, 1);
  }
  .nav-link:hover { color: var(--dun-cream); }
  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left center;
  }
  .nav-link.is-active {
    color: var(--dun-cream);
  }
  .nav-link.is-active::after {
    transform: scaleX(1);
    background: var(--dun-cream-dark);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: rgba(236, 234, 219, 0.8);
    transition: color 200ms ease;
    position: relative;
  }
  .footer-link:hover {
    color: var(--dun-cream);
  }
  .footer-link::before {
    content: '';
    opacity: 0;
    margin-right: 2px;
    transition: opacity 200ms ease;
  }
  .footer-link:hover::before {
    opacity: 1;
  }

  /* ====== Reveal animations (used with data-reveal attribute) ====== */
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 900ms cubic-bezier(0.2, 0.7, 0.2, 1),
                transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .js [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    .anim-rise {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
    html { scroll-behavior: auto; }
  }

  /* ====== Page-load staggered fade (immediate, no observer) ====== */
  @keyframes dun-fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .anim-rise {
    opacity: 0;
    animation: dun-fade-in-up 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: var(--rise-delay, 0ms);
  }

  .italic-faux { font-style: italic; }

  /* ====== Decorative big numeral ====== */
  .dun-numeral {
    font-family: 'Lexend', system-ui, sans-serif;
    font-weight: 100;
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--dun-cream-dark);
    opacity: 0.55;
    font-feature-settings: 'tnum';
  }

  /* ====== Hairline rule (used between sections) ====== */
  .dun-rule {
    height: 1px;
    background: linear-gradient(to right,
      transparent 0%,
      rgba(204, 160, 103, 0.35) 20%,
      rgba(204, 160, 103, 0.35) 80%,
      transparent 100%);
  }

  /* ====== Prose overrides ====== */
  .prose { color: #cca067; }
  .prose h2 {
    color: #eceadb;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .prose p, .prose li { color: #cca067; }
  .prose a { color: #eceadb; text-decoration: underline; text-decoration-color: rgba(204,160,103,0.4); text-underline-offset: 4px; }
  .prose strong { color: #eceadb; font-weight: 500; }

  /* ====== Image hover treatment shared across cards/galleries ====== */
  .img-frame {
    position: relative;
    overflow: hidden;
  }
  .img-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(2,43,41,0.45) 0%, transparent 45%);
    opacity: 0.6;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .img-frame:hover::after { opacity: 0.85; }
</style>
